---
---

<section
  id="servicios"
  class="min-h-screen bg-black px-6 py-10 lg:px-8"
>
  <div class="mx-auto max-w-7xl">

    <!-- ========================================== -->
    <!-- ENCABEZADO -->
    <!-- ========================================== -->

    <div class="mx-auto max-w-3xl text-center">

      <p class="mb-4 text-xs font-medium uppercase tracking-[0.3em] text-[#D4AF37]">
        Modelos de servicio
      </p>

      <h1 class="text-4xl font-bold tracking-tight text-white sm:text-5xl lg:text-6xl">
        Elige la forma de trabajar
        <span class="text-[#D4AF37]"> que mejor se adapte a tu empresa.</span>
      </h1>

      <p class="mt-6 text-base leading-7 text-white/50 sm:text-lg">
        Dos modelos flexibles para empresas que participan en contratación pública y privada:
        suscripción mensual o acompañamiento por licitación.
      </p>

    </div>

    <!-- ========================================== -->
    <!-- MODELO 1 -->
    <!-- ========================================== -->

    <div class="mt-20 overflow-hidden rounded-3xl border border-[#D4AF37]/20 bg-[#0B0B0B]">

      <!-- Cabecera -->
      <div class="border-b border-white/10 p-8 lg:p-12">

        <div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">

          <div class="max-w-2xl">

            <div class="mb-4 inline-flex items-center gap-2 rounded-full border border-[#D4AF37]/30 bg-[#D4AF37]/10 px-3 py-1 text-xs font-medium text-[#D4AF37]">
              MODELO 01
            </div>

            <h2 class="text-3xl font-bold text-white sm:text-4xl">
              Suscripción mensual
            </h2>

            <p class="mt-4 text-lg text-[#D4AF37]">
              Pagas por la cantidad de procesos analizados cada mes.
            </p>

            <p class="mt-4 text-white/50">
              Ideal para empresas que necesitan monitorear oportunidades de contratación de forma continua y contar con un aliado estratégico durante todo el mes.
            </p>

          </div>

          <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-6 text-center">

            <p class="text-sm text-white/40">Modelo recomendado para</p>

            <p class="mt-2 text-xl font-semibold text-white">
              Empresas con participación constante
            </p>

          </div>

        </div>

      </div>

      <!-- Planes -->
      <div class="grid gap-6 p-8 lg:grid-cols-3 lg:p-12">

        <!-- Plan 5 -->
        <article class="group rounded-2xl border border-white/10 bg-black/30 p-6 transition-all duration-300 hover:-translate-y-1 hover:border-[#D4AF37]/40">

          <div class="flex items-center justify-between">

            <span class="text-sm font-medium text-white/50">Plan Esencial</span>

            <span class="rounded-full bg-[#D4AF37]/10 px-3 py-1 text-xs font-semibold text-[#D4AF37]">
              5 procesos
            </span>

          </div>

          <div class="mt-6">

            <p class="text-sm text-white/40">Desde</p>

            <h3 class="mt-1 text-4xl font-bold text-white">
              $____
            </h3>

            <p class="mt-1 text-sm text-white/40">/ mes</p>

          </div>

          <div class="my-6 h-px bg-white/10"></div>

          <ul class="space-y-3 text-sm text-white/60">
            <li class="flex gap-2">
              <span class="text-[#D4AF37]">✓</span>
              Hasta 5 procesos analizados
            </li>
            <li class="flex gap-2">
              <span class="text-[#D4AF37]">✓</span>
              Identificación de oportunidades
            </li>
            <li class="flex gap-2">
              <span class="text-[#D4AF37]">✓</span>
              Revisión inicial de requisitos
            </li>
            <li class="flex gap-2">
              <span class="text-[#D4AF37]">✓</span>
              Informe de viabilidad
            </li>
          </ul>

          <a href="/#contacto" class="mt-8 flex items-center justify-center rounded-full border border-white/15 py-3 text-sm font-medium text-white transition hover:border-[#D4AF37] hover:text-[#D4AF37]">
            Solicitar información
          </a>

        </article>

        <!-- Plan 10 -->
        <article class="group relative rounded-2xl border border-[#D4AF37]/40 bg-[#111111] p-6 shadow-lg shadow-black/30 transition-all duration-300 hover:-translate-y-2">

          <div class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-[#D4AF37] px-4 py-1 text-[10px] font-bold uppercase tracking-[0.2em] text-black">
            Más solicitado
          </div>

          <div class="flex items-center justify-between">

            <span class="text-sm font-medium text-white/50">Plan Profesional</span>

            <span class="rounded-full bg-[#D4AF37]/10 px-3 py-1 text-xs font-semibold text-[#D4AF37]">
              10 procesos
            </span>

          </div>

          <div class="mt-6">

            <p class="text-sm text-white/40">Desde</p>

            <h3 class="mt-1 text-4xl font-bold text-white">
              $____
            </h3>

            <p class="mt-1 text-sm text-white/40">/ mes</p>

          </div>

          <div class="my-6 h-px bg-white/10"></div>

          <ul class="space-y-3 text-sm text-white/60">
            <li class="flex gap-2">
              <span class="text-[#D4AF37]">✓</span>
              Hasta 10 procesos mensuales
            </li>
            <li class="flex gap-2">
              <span class="text-[#D4AF37]">✓</span>
              Análisis detallado de pliegos
            </li>
            <li class="flex gap-2">
              <span class="text-[#D4AF37]">✓</span>
              Priorización de oportunidades
            </li>
            <li class="flex gap-2">
              <span class="text-[#D4AF37]">✓</span>
              Acompañamiento continuo
            </li>
          </ul>

          <a href="/#contacto" class="mt-8 flex items-center justify-center rounded-full bg-[#D4AF37] py-3 text-sm font-semibold text-black transition hover:bg-[#E2C45A]">
            Elegir este plan
          </a>

        </article>

        <!-- Plan 20 -->
        <article class="group rounded-2xl border border-white/10 bg-black/30 p-6 transition-all duration-300 hover:-translate-y-1 hover:border-[#D4AF37]/40">

          <div class="flex items-center justify-between">

            <span class="text-sm font-medium text-white/50">Plan Empresarial</span>

            <span class="rounded-full bg-[#D4AF37]/10 px-3 py-1 text-xs font-semibold text-[#D4AF37]">
              20 procesos
            </span>

          </div>

          <div class="mt-6">

            <p class="text-sm text-white/40">Desde</p>

            <h3 class="mt-1 text-4xl font-bold text-white">
              $____
            </h3>

            <p class="mt-1 text-sm text-white/40">/ mes</p>

          </div>

          <div class="my-6 h-px bg-white/10"></div>

          <ul class="space-y-3 text-sm text-white/60">
            <li class="flex gap-2">
              <span class="text-[#D4AF37]">✓</span>
              Hasta 20 procesos mensuales
            </li>
            <li class="flex gap-2">
              <span class="text-[#D4AF37]">✓</span>
              Seguimiento estratégico
            </li>
            <li class="flex gap-2">
              <span class="text-[#D4AF37]">✓</span>
              Priorización avanzada
            </li>
            <li class="flex gap-2">
              <span class="text-[#D4AF37]">✓</span>
              Atención preferencial
            </li>
          </ul>

          <a href="/#contacto" class="mt-8 flex items-center justify-center rounded-full border border-white/15 py-3 text-sm font-medium text-white transition hover:border-[#D4AF37] hover:text-[#D4AF37]">
            Solicitar cotización
          </a>

        </article>

      </div>

    </div>

    <!-- ========================================== -->
    <!-- MODELO 2 -->
    <!-- ========================================== -->

    <div class="mt-16 overflow-hidden rounded-3xl border border-white/10 bg-[#0B0B0B]">

      <div class="grid lg:grid-cols-2">

        <!-- Texto -->
        <div class="p-8 lg:p-12">

          <div class="mb-4 inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/[0.03] px-3 py-1 text-xs font-medium text-white/60">
            MODELO 02
          </div>

          <h2 class="text-3xl font-bold text-white sm:text-4xl">
            Por licitación
          </h2>

          <p class="mt-4 text-lg text-[#D4AF37]">
            Contratas únicamente cuando aparece una licitación específica.
          </p>

          <p class="mt-5 text-white/50">
            Este modelo combina un honorario por el trabajo realizado con un esquema de éxito cuando el proceso es adjudicado, adaptándose a las necesidades de cada empresa.
          </p>

          <div class="mt-8 rounded-2xl border border-[#D4AF37]/20 bg-[#D4AF37]/5 p-5">
            <p class="text-sm font-medium text-[#D4AF37]">
              Ideal para empresas que participan ocasionalmente en procesos de contratación y no requieren una suscripción mensual.
            </p>
          </div>

          <a href="/#contacto" class="mt-8 inline-flex items-center gap-3 rounded-full bg-[#D4AF37] px-6 py-3 text-sm font-semibold text-black transition hover:bg-[#E2C45A]">
            Solicitar una propuesta
            <span>→</span>
          </a>

        </div>

        <!-- Flujo -->
        <div class="flex items-center p-8 lg:p-12">

          <div class="w-full space-y-5">

            <div class="flex items-center gap-4 rounded-2xl border border-white/10 bg-black/30 p-5">
              <div class="flex h-12 w-12 items-center justify-center rounded-full bg-[#D4AF37]/10 text-[#D4AF37] font-bold">
                01
              </div>
              <div>
                <h3 class="font-semibold text-white">Análisis</h3>
                <p class="text-sm text-white/45">
                  Estudio del proceso y evaluación de viabilidad.
                </p>
              </div>
            </div>

            <div class="flex items-center gap-4 rounded-2xl border border-white/10 bg-black/30 p-5">
              <div class="flex h-12 w-12 items-center justify-center rounded-full bg-[#D4AF37]/10 text-[#D4AF37] font-bold">
                02
              </div>
              <div>
                <h3 class="font-semibold text-white">Preparación</h3>
                <p class="text-sm text-white/45">
                  Desarrollo de la propuesta técnica y económica.
                </p>
              </div>
            </div>

            <div class="flex items-center gap-4 rounded-2xl border border-white/10 bg-black/30 p-5">
              <div class="flex h-12 w-12 items-center justify-center rounded-full bg-[#D4AF37]/10 text-[#D4AF37] font-bold">
                03
              </div>
              <div>
                <h3 class="font-semibold text-white">Presentación</h3>
                <p class="text-sm text-white/45">
                  Revisión final y acompañamiento en la entrega.
                </p>
              </div>
            </div>

            <div class="flex items-center gap-4 rounded-2xl border border-white/10 bg-black/30 p-5">
              <div class="flex h-12 w-12 items-center justify-center rounded-full bg-[#D4AF37]/10 text-[#D4AF37] font-bold">
                04
              </div>
              <div>
                <h3 class="font-semibold text-white">Adjudicación</h3>
                <p class="text-sm text-white/45">
                  Honorario de éxito cuando el proceso es adjudicado.
                </p>
              </div>
            </div>

          </div>

        </div>

      </div>

    </div>

    <!-- ========================================== -->
    <!-- CTA FINAL -->
    <!-- ========================================== -->

    <div class="mt-20 text-center">

      <p class="text-sm uppercase tracking-[0.3em] text-[#D4AF37]">
        ¿No sabes cuál elegir?
      </p>

      <h2 class="mt-4 text-3xl font-bold text-white sm:text-4xl">
        Te ayudo a definir el modelo ideal para tu empresa.
      </h2>

      <p class="mx-auto mt-5 max-w-2xl text-white/50">
        Cada organización tiene un volumen de procesos y necesidades diferentes.
        Con una breve conversación podemos recomendar el servicio más conveniente.
      </p>

      <a href="/#contacto" class="mt-8 inline-flex items-center gap-3 rounded-full bg-[#D4AF37] px-7 py-3.5 text-sm font-semibold text-black transition hover:gap-5 hover:bg-[#E2C45A]">
        Agendar una asesoría
        <span>→</span>
      </a>

    </div>

  </div>
</section>