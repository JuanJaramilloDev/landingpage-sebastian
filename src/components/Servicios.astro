---
const WHATSAPP = "https://wa.me/573005097039";

const planes = [
  {
    nombre: "Esencial",
    creditos: "5 créditos",
    precio: "$900.000",
    porCredito: "$180.000 / crédito",
    ahorro: "Ahorro: $100.000",
    vigencia: "Vigencia: 6 meses",
    destacado: false,
  },
  {
    nombre: "Profesional",
    creditos: "10 créditos",
    precio: "$1.700.000",
    porCredito: "$170.000 / crédito",
    ahorro: "Ahorro: $300.000",
    vigencia: "Vigencia: 9 meses",
    destacado: true,
  },
  {
    nombre: "Empresarial",
    creditos: "20 créditos",
    precio: "$3.200.000",
    porCredito: "$160.000 / crédito",
    ahorro: "Ahorro: $800.000",
    vigencia: "Vigencia: 12 meses",
    destacado: false,
  },
  {
    nombre: "Corporativo",
    creditos: "40 créditos",
    precio: "$6.000.000",
    porCredito: "$150.000 / crédito",
    ahorro: "Ahorro: $2.000.000",
    vigencia: "Vigencia: 12 meses",
    destacado: false,
  },
];

const consumo = [
  {
    color: "bg-emerald-400",
    nivel: "Básico",
    detalle: "Mínima cuantía sencilla",
    creditos: "1 crédito",
  },
  {
    color: "bg-yellow-400",
    nivel: "Intermedio",
    detalle: "Subasta inversa",
    creditos: "2 créditos",
  },
  {
    color: "bg-yellow-400",
    nivel: "Intermedio",
    detalle: "Selección abreviada",
    creditos: "2 créditos",
  },
  {
    color: "bg-orange-400",
    nivel: "Avanzado",
    detalle: "Proceso de complejidad media",
    creditos: "2 créditos",
  },
  {
    color: "bg-red-500",
    nivel: "Complejo",
    detalle: "Licitación pública de alta complejidad",
    creditos: "3 créditos",
  },
  {
    color: "bg-white/40",
    nivel: "Especial",
    detalle: "Procesos excepcionales",
    creditos: "Cotización personalizada",
  },
];

const incluye = [
  "Análisis del proceso",
  "Revisión de requisitos jurídicos, financieros y técnicos",
  "Revisión de experiencia y documentación",
  "Identificación de riesgos y causales de rechazo",
  "Organización documental",
  "Preparación y revisión de la oferta",
  "Cargue y presentación",
  "Seguimiento",
  "Revisión de evaluaciones, requerimientos, subsanaciones y modificaciones",
];

const noIncluye = [
  "Búsqueda de precios de mercado",
  "Solicitud de cotizaciones",
  "Negociación con proveedores",
  "Elaboración del presupuesto comercial",
  "Determinación del precio de venta",
  "Adquisición de documentos que correspondan al cliente",
  "Elaboración de documentos técnicos que requieran información no suministrada",
];
---

<section
  id="servicios"
  class="relative overflow-hidden bg-black px-6 py-24 lg:px-8"
>
  <!-- Detalles decorativos de fondo -->
  <div
    class="pointer-events-none absolute -left-32 top-20 h-80 w-80 rounded-full bg-[#D4AF37]/5 blur-3xl"
  ></div>

  <div
    class="pointer-events-none absolute -right-32 bottom-10 h-96 w-96 rounded-full bg-[#D4AF37]/5 blur-3xl"
  ></div>

  <div class="relative mx-auto max-w-7xl">

    <!-- ========================================== -->
    <!-- 1. EL PROBLEMA, NO LOS CRÉDITOS -->
    <!-- ========================================== -->

    <div class="mx-auto max-w-3xl text-center" data-reveal>

      <p class="mb-4 text-xs font-medium uppercase tracking-[0.3em] text-[#D4AF37]">
        Modelo de servicio
      </p>

      <h1 class="text-4xl font-bold tracking-tight text-white sm:text-5xl lg:text-6xl">
        Participa en más licitaciones sin
        <span class="text-[#D4AF37]"> contratar un analista de tiempo completo.</span>
      </h1>

      <p class="mt-6 text-base leading-7 text-white/50 sm:text-lg">
        En LICITERRA analizamos, preparamos y acompañamos tus procesos de
        contratación pública para que puedas concentrarte en tu negocio
        mientras nosotros nos encargamos de la gestión de la licitación.
      </p>

      <div class="mt-10 flex flex-wrap items-center justify-center gap-4">

        <a
          href="/#contacto"
          data-scroll="contacto"
          class="group animate-glow-pulse inline-flex items-center gap-3 rounded-full bg-[#D4AF37] px-7 py-3.5 text-sm font-semibold text-black transition-all duration-300 hover:-translate-y-1 hover:bg-[#F0D477]"
        >
          Analizar mi próxima licitación
          <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
        </a>

        <a
          href={WHATSAPP}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-full border border-white/20 px-7 py-3.5 text-sm font-semibold text-white transition-all duration-300 hover:-translate-y-1 hover:border-[#D4AF37] hover:text-[#D4AF37]"
        >
          Hablar con un especialista
        </a>

      </div>

    </div>

    <!-- ========================================== -->
    <!-- 2. CÓMO FUNCIONA -->
    <!-- ========================================== -->

    <div class="mt-24">

      <p class="text-center text-xs font-medium uppercase tracking-[0.3em] text-[#D4AF37]" data-reveal>
        Cómo funciona
      </p>

      <h2 class="mt-3 text-center text-3xl font-bold text-white sm:text-4xl" data-reveal>
        Cinco pasos, sin complicaciones.
      </h2>

      <div class="mt-14 grid gap-5 lg:grid-cols-5">

        {[
          { n: "01", t: "Encuentra una oportunidad" },
          { n: "02", t: "Envíala a LICITERRA" },
          { n: "03", t: "Utilizamos tus créditos según la complejidad" },
          { n: "04", t: "Trabajamos contigo" },
          { n: "05", t: "Seguimos el proceso" },
        ].map((paso, i) => (
          <div
            class="group flex flex-col items-start gap-4 rounded-2xl border border-white/10 bg-[#0B0B0B] p-6 transition-all duration-300 hover:-translate-y-1 hover:border-[#D4AF37]/40"
            data-reveal
            data-reveal-delay={String(Math.min(i, 3))}
          >
            <div class="flex h-11 w-11 items-center justify-center rounded-xl border border-[#D4AF37]/30 bg-black text-xs font-bold text-[#D4AF37] transition-all duration-300 group-hover:bg-[#D4AF37] group-hover:text-black">
              {paso.n}
            </div>
            <p class="text-sm leading-6 text-white/70">{paso.t}</p>
          </div>
        ))}

      </div>

    </div>

    <!-- ========================================== -->
    <!-- 3. DOS NIVELES DE SERVICIO -->
    <!-- ========================================== -->

    <div class="mt-24 grid gap-6 lg:grid-cols-2">

      <div
        class="rounded-3xl border border-white/10 bg-[#0B0B0B] p-8 transition-all duration-300 hover:border-[#D4AF37]/30 lg:p-10"
        data-reveal="left"
      >
        <div class="mb-4 inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/[0.03] px-3 py-1 text-xs font-medium text-white/60">
          NIVEL 01
        </div>

        <h3 class="text-2xl font-bold text-white sm:text-3xl">
          LICITERRA Analiza
        </h3>

        <p class="mt-4 text-white/50">
          Ayudamos a determinar si el cliente puede y le conviene participar.
        </p>

        <p class="mt-4 text-sm leading-6 text-white/40">
          Incluye análisis, revisión y concepto de viabilidad.
        </p>
      </div>

      <div
        class="rounded-3xl border border-[#D4AF37]/30 bg-[#0B0B0B] p-8 transition-all duration-300 hover:border-[#D4AF37]/60 lg:p-10"
        data-reveal="right"
      >
        <div class="mb-4 inline-flex items-center gap-2 rounded-full border border-[#D4AF37]/30 bg-[#D4AF37]/10 px-3 py-1 text-xs font-medium text-[#D4AF37]">
          NIVEL 02
        </div>

        <h3 class="text-2xl font-bold text-white sm:text-3xl">
          LICITERRA Acompaña
        </h3>

        <p class="mt-4 text-[#D4AF37]">
          Acompañamos al cliente durante preparación y presentación.
        </p>

        <p class="mt-4 text-sm leading-6 text-white/40">
          Puede incluir análisis, organización documental, preparación,
          revisión, cargue, presentación, seguimiento y subsanaciones según
          el alcance contratado.
        </p>
      </div>

    </div>

    <!-- ========================================== -->
    <!-- 4. CÓMO FUNCIONAN LOS CRÉDITOS -->
    <!-- ========================================== -->

    <div class="mt-24 overflow-hidden rounded-3xl border border-[#D4AF37]/20 bg-[#0B0B0B]">

      <div class="grid gap-10 p-8 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16 lg:p-12">

        <div data-reveal>

          <p class="text-xs font-medium uppercase tracking-[0.3em] text-[#D4AF37]">
            Créditos LICITERRA
          </p>

          <h2 class="mt-3 text-3xl font-bold text-white sm:text-4xl">
            No vendemos horas, vendemos resultados.
          </h2>

          <p class="mt-5 text-white/50">
            Compras créditos y los consumes según la complejidad y el alcance
            de cada proceso de contratación pública.
          </p>

          <div class="mt-8 inline-flex items-baseline gap-2 rounded-2xl border border-[#D4AF37]/30 bg-[#D4AF37]/5 px-6 py-4">
            <span class="text-3xl font-bold text-[#D4AF37]">1 crédito</span>
            <span class="text-white/50">=</span>
            <span class="text-3xl font-bold text-white">$200.000</span>
          </div>

          <p class="mt-6 text-xs leading-6 text-white/35">
            La clasificación puede ajustarse según la complejidad real del
            proceso, aunque su modalidad sea aparentemente sencilla.
          </p>

        </div>

        <div class="space-y-3" data-reveal data-reveal-delay="1">

          {consumo.map((item) => (
            <div class="flex items-center justify-between gap-4 rounded-xl border border-white/10 bg-black/30 px-5 py-4">
              <div class="flex items-center gap-3">
                <span class={`h-2.5 w-2.5 shrink-0 rounded-full ${item.color}`}></span>
                <div>
                  <p class="text-sm font-medium text-white">{item.nivel}</p>
                  <p class="text-xs text-white/40">{item.detalle}</p>
                </div>
              </div>
              <span class="shrink-0 rounded-full bg-[#D4AF37]/10 px-3 py-1 text-xs font-semibold text-[#D4AF37]">
                {item.creditos}
              </span>
            </div>
          ))}

        </div>

      </div>

    </div>

    <!-- ========================================== -->
    <!-- 5. PLANES -->
    <!-- ========================================== -->

    <div class="mt-24">

      <div class="mx-auto max-w-2xl text-center" data-reveal>
        <p class="text-xs font-medium uppercase tracking-[0.3em] text-[#D4AF37]">
          Planes de créditos
        </p>
        <h2 class="mt-3 text-3xl font-bold text-white sm:text-4xl">
          Elige la bolsa que mejor se adapte a tu volumen.
        </h2>
      </div>

      <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">

        {planes.map((plan, i) => (
          <article
            class={`group relative flex flex-col rounded-2xl p-6 transition-all duration-300 ${
              plan.destacado
                ? "border border-[#D4AF37]/40 bg-[#111111] shadow-lg shadow-black/30 hover:-translate-y-2"
                : "border border-white/10 bg-black/30 hover:-translate-y-1 hover:border-[#D4AF37]/40"
            }`}
            data-reveal
            data-reveal-delay={String(i)}
          >

            {plan.destacado && (
              <div class="absolute -top-3 left-1/2 -translate-x-1/2 whitespace-nowrap rounded-full bg-[#D4AF37] px-4 py-1 text-[10px] font-bold uppercase tracking-[0.2em] text-black">
                Más elegido
              </div>
            )}

            <span class="text-sm font-medium text-white/50">{plan.nombre}</span>

            <span class="mt-3 inline-block w-fit rounded-full bg-[#D4AF37]/10 px-3 py-1 text-xs font-semibold text-[#D4AF37]">
              {plan.creditos}
            </span>

            <h3 class="mt-6 text-3xl font-bold text-white">
              {plan.precio}
            </h3>

            <p class="mt-1 text-xs text-white/40">{plan.porCredito}</p>

            <div class="my-6 h-px bg-white/10"></div>

            <ul class="space-y-2 text-xs text-white/50">
              <li class="flex gap-2">
                <span class="text-[#D4AF37]">✓</span>
                {plan.ahorro}
              </li>
              <li class="flex gap-2">
                <span class="text-[#D4AF37]">✓</span>
                {plan.vigencia}
              </li>
              {plan.nombre === "Corporativo" && (
                <li class="flex gap-2">
                  <span class="text-[#D4AF37]">✓</span>
                  Prioridad de atención y contacto asignado
                </li>
              )}
            </ul>

            <a
              href="/#contacto"
              data-scroll="contacto"
              class={`mt-8 flex items-center justify-center rounded-full py-3 text-sm font-medium transition ${
                plan.destacado
                  ? "bg-[#D4AF37] text-black hover:bg-[#E2C45A]"
                  : "border border-white/15 text-white hover:border-[#D4AF37] hover:text-[#D4AF37]"
              }`}
            >
              Comprar créditos
            </a>

          </article>
        ))}

      </div>

      <p class="mx-auto mt-8 max-w-2xl text-center text-xs leading-6 text-white/35" data-reveal>
        Si un proceso comenzó utilizando créditos de una bolsa, mantiene su
        cobertura hasta la terminación del proceso contratado aunque la
        vigencia general de la bolsa haya terminado.
      </p>

    </div>

    <!-- ========================================== -->
    <!-- 6. LICITACIÓN INDIVIDUAL -->
    <!-- ========================================== -->

    <div class="mt-16 overflow-hidden rounded-3xl border border-white/10 bg-[#0B0B0B]">

      <div class="flex flex-col items-start gap-6 p-8 sm:flex-row sm:items-center sm:justify-between lg:p-12" data-reveal>

        <div class="max-w-xl">

          <div class="mb-4 inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/[0.03] px-3 py-1 text-xs font-medium text-white/60">
            SERVICIO INDIVIDUAL
          </div>

          <h2 class="text-2xl font-bold text-white sm:text-3xl">
            Contrata una licitación individual
          </h2>

          <p class="mt-4 text-white/50">
            El precio final depende de la modalidad, cuantía, complejidad,
            documentación, requisitos, tiempo disponible y alcance del
            proceso.
          </p>

        </div>

        <div class="flex shrink-0 flex-col items-start gap-4 sm:items-end">

          <p class="text-3xl font-bold text-white">
            Desde <span class="text-[#D4AF37]">$200.000</span>
          </p>

          <a
            href="/#contacto"
            data-scroll="contacto"
            class="inline-flex items-center gap-3 rounded-full bg-[#D4AF37] px-6 py-3 text-sm font-semibold text-black transition hover:bg-[#E2C45A]"
          >
            Cotizar mi licitación
            <span>→</span>
          </a>

        </div>

      </div>

    </div>

    <!-- ========================================== -->
    <!-- 7. QUÉ INCLUYE / QUÉ NO INCLUYE -->
    <!-- ========================================== -->

    <div class="mt-24 grid gap-6 lg:grid-cols-2">

      <div class="rounded-2xl border border-white/10 bg-black/30 p-8" data-reveal="left">
        <p class="text-xs font-medium uppercase tracking-[0.3em] text-[#D4AF37]">
          Qué incluye
        </p>
        <ul class="mt-6 space-y-3 text-sm text-white/60">
          {incluye.map((item) => (
            <li class="flex gap-3">
              <span class="text-[#D4AF37]">✓</span>
              {item}
            </li>
          ))}
        </ul>
      </div>

      <div class="rounded-2xl border border-white/10 bg-black/30 p-8" data-reveal="right">
        <p class="text-xs font-medium uppercase tracking-[0.3em] text-white/40">
          Qué no incluye
        </p>
        <ul class="mt-6 space-y-3 text-sm text-white/40">
          {noIncluye.map((item) => (
            <li class="flex gap-3">
              <span class="text-white/30">–</span>
              {item}
            </li>
          ))}
        </ul>
      </div>

    </div>

    <!-- ========================================== -->
    <!-- 8. LICITERRA VS. ANALISTA DE PLANTA -->
    <!-- ========================================== -->

    <div class="mt-24 overflow-hidden rounded-3xl border border-white/10 bg-[#0B0B0B]">

      <div class="p-8 pb-0 text-center lg:p-12 lg:pb-0" data-reveal>
        <p class="text-xs font-medium uppercase tracking-[0.3em] text-[#D4AF37]">
          ¿Por qué LICITERRA?
        </p>
        <h2 class="mt-3 text-3xl font-bold text-white sm:text-4xl">
          Una alternativa a contratar un analista de planta.
        </h2>
      </div>

      <div class="grid divide-y divide-white/10 lg:grid-cols-2 lg:divide-x lg:divide-y-0">

        <div class="p-8 lg:p-12" data-reveal="left">
          <h3 class="text-sm font-semibold uppercase tracking-wider text-white/40">
            Analista interno
          </h3>
          <ul class="mt-5 space-y-3 text-sm text-white/50">
            <li class="flex gap-3"><span class="text-white/30">–</span> Costo fijo</li>
            <li class="flex gap-3"><span class="text-white/30">–</span> Prestaciones sociales</li>
            <li class="flex gap-3"><span class="text-white/30">–</span> Capacidad limitada</li>
            <li class="flex gap-3"><span class="text-white/30">–</span> Vacaciones e incapacidades</li>
            <li class="flex gap-3"><span class="text-white/30">–</span> Costos de estructura</li>
          </ul>
        </div>

        <div class="p-8 lg:p-12" data-reveal="right">
          <h3 class="text-sm font-semibold uppercase tracking-wider text-[#D4AF37]">
            LICITERRA
          </h3>
          <ul class="mt-5 space-y-3 text-sm text-white/70">
            <li class="flex gap-3"><span class="text-[#D4AF37]">✓</span> Pago según necesidad</li>
            <li class="flex gap-3"><span class="text-[#D4AF37]">✓</span> Equipo especializado</li>
            <li class="flex gap-3"><span class="text-[#D4AF37]">✓</span> Capacidad escalable</li>
            <li class="flex gap-3"><span class="text-[#D4AF37]">✓</span> Continuidad del servicio</li>
          </ul>
        </div>

      </div>

    </div>

    <!-- ========================================== -->
    <!-- 9. PARA CADA TIPO DE EMPRESA -->
    <!-- ========================================== -->

    <div class="mt-24 grid gap-5 lg:grid-cols-3">

      {[
        { tipo: "PYMES", mensaje: "¿No tienes un analista de licitaciones? Nosotros podemos hacerlo por ti." },
        { tipo: "Empresas medianas", mensaje: "¿Tu equipo no alcanza a atender todas las oportunidades? LICITERRA se convierte en tu capacidad adicional." },
        { tipo: "Empresas grandes", mensaje: "Refuerza tu equipo de licitaciones sin aumentar tu estructura de nómina." },
      ].map((item, i) => (
        <div
          class="rounded-2xl border border-white/10 bg-black/30 p-7 transition-all duration-300 hover:-translate-y-1 hover:border-[#D4AF37]/40"
          data-reveal
          data-reveal-delay={String(i)}
        >
          <p class="text-xs font-medium uppercase tracking-[0.2em] text-[#D4AF37]">
            {item.tipo}
          </p>
          <p class="mt-4 text-sm leading-7 text-white/60">
            {item.mensaje}
          </p>
        </div>
      ))}

    </div>

    <!-- ========================================== -->
    <!-- NOTA ACLARATORIA -->
    <!-- ========================================== -->

    <p class="mx-auto mt-16 max-w-3xl text-center text-xs italic leading-6 text-white/30" data-reveal>
      La clasificación de cada proceso es realizada por LICITERRA de acuerdo
      con su modalidad, cuantía, requisitos, complejidad documental, técnica
      y financiera, cronograma y alcance del servicio solicitado.
    </p>

    <!-- ========================================== -->
    <!-- CTA FINAL -->
    <!-- ========================================== -->

    <div class="mt-16 text-center" data-reveal>

      <h2 class="text-3xl font-bold text-white sm:text-4xl">
        ¿No sabes cuántos créditos necesitas?
      </h2>

      <p class="mx-auto mt-5 max-w-2xl text-white/50">
        Cada organización tiene un volumen de procesos y necesidades
        diferentes. Con una breve conversación podemos recomendar el plan
        más conveniente.
      </p>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">

        <a
          href="/#contacto"
          data-scroll="contacto"
          class="inline-flex items-center gap-3 rounded-full bg-[#D4AF37] px-7 py-3.5 text-sm font-semibold text-black transition hover:-translate-y-1 hover:bg-[#E2C45A]"
        >
          Comprar créditos
          <span>→</span>
        </a>

        <a
          href="/#contacto"
          data-scroll="contacto"
          class="inline-flex items-center gap-3 rounded-full border border-white/15 px-7 py-3.5 text-sm font-semibold text-white transition hover:-translate-y-1 hover:border-[#D4AF37] hover:text-[#D4AF37]"
        >
          Cotizar una licitación
        </a>

        <a
          href={WHATSAPP}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-3 rounded-full border border-white/15 px-7 py-3.5 text-sm font-semibold text-white transition hover:-translate-y-1 hover:border-[#D4AF37] hover:text-[#D4AF37]"
        >
          Hablar con un especialista
        </a>

      </div>

    </div>

  </div>
</section>
