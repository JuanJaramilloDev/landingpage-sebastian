---
---

<section class="relative overflow-hidden bg-black px-6 py-20 lg:px-8">

  <!-- Brillo dorado de fondo -->
  <div
    class="pointer-events-none absolute left-1/2 top-1/2 h-96 w-96 -translate-x-1/2 -translate-y-1/2 rounded-full bg-[#D4AF37]/10 blur-[130px]"
  ></div>


  <div class="relative mx-auto max-w-5xl">

    <!-- Etiqueta superior -->
    <div class="mb-8 flex items-center justify-center gap-4" data-reveal>

      <div class="h-px w-16 bg-gradient-to-r from-transparent to-[#D4AF37]/50"></div>

      <span
        class="text-[10px] uppercase tracking-[0.35em] text-[#D4AF37]/70"
      >
        Perfil profesional
      </span>

      <div class="h-px w-16 bg-gradient-to-l from-transparent to-[#D4AF37]/50"></div>

    </div>


    <!-- ========================================== -->
    <!-- TARJETA -->
    <!-- ========================================== -->

    <div
      class="group relative mx-auto max-w-4xl"
      data-reveal
      data-reveal-delay="1"
    >

      <!-- Sombra / resplandor -->
      <div
        class="absolute -inset-3 rounded-2xl bg-[#D4AF37]/10 opacity-0 blur-2xl transition duration-700 group-hover:opacity-100"
      ></div>


      <!-- Marco exterior -->
      <div
        class="relative rounded-2xl border border-[#D4AF37]/30 bg-[#0A0A0A] p-2 shadow-2xl shadow-black/80 transition-all duration-700 group-hover:border-[#D4AF37]/60"
      >

        <!-- Marco interior -->
        <div
          class="relative overflow-hidden rounded-xl border border-white/10 bg-[#080808]"
        >

          <!-- Imagen -->
          <img
            src="/images/carta.png"
            alt="Juan Sebastián Guerra - Analista de Licitaciones"
            class="block h-auto w-full object-cover transition duration-700 group-hover:scale-[1.01]"
          />


          <!-- Overlay sutil -->
          <div
            class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/20 via-transparent to-transparent"
          ></div>

        </div>

      </div>


      <!-- ========================================== -->
      <!-- DECORACIONES -->
      <!-- ========================================== -->

      <!-- Esquina superior izquierda -->
      <div
        class="absolute -left-3 -top-3 h-16 w-16 border-l border-t border-[#D4AF37]/60 transition-all duration-500 group-hover:-left-4 group-hover:-top-4 group-hover:border-[#D4AF37]"
      ></div>


      <!-- Esquina superior derecha -->
      <div
        class="absolute -right-3 -top-3 h-16 w-16 border-r border-t border-[#D4AF37]/60 transition-all duration-500 group-hover:-right-4 group-hover:-top-4 group-hover:border-[#D4AF37]"
      ></div>


      <!-- Esquina inferior izquierda -->
      <div
        class="absolute -bottom-3 -left-3 h-16 w-16 border-b border-l border-[#D4AF37]/60 transition-all duration-500 group-hover:-bottom-4 group-hover:-left-4 group-hover:border-[#D4AF37]"
      ></div>


      <!-- Esquina inferior derecha -->
      <div
        class="absolute -bottom-3 -right-3 h-16 w-16 border-b border-r border-[#D4AF37]/60 transition-all duration-500 group-hover:-bottom-4 group-hover:-right-4 group-hover:border-[#D4AF37]"
      ></div>

    </div>


    <!-- Texto inferior -->
    <div class="mt-8 flex items-center justify-center gap-4" data-reveal data-reveal-delay="2">

      <span class="h-1 w-1 rounded-full bg-[#D4AF37]"></span>

      <p
        class="text-center text-xs tracking-[0.15em] text-white/30"
      >
        INGENIERÍA BIOMÉDICA · LICITACIONES · CONTRATACIÓN
      </p>

      <span class="h-1 w-1 rounded-full bg-[#D4AF37]"></span>

    </div>

  </div>

</section>