---
---

<section
  id="contacto"
  class="relative overflow-hidden border-t border-white/5 bg-[#080808] px-6 py-15 lg:px-8"
>

  <div
    class="animate-float-slow pointer-events-none absolute -left-40 bottom-0 h-96 w-96 rounded-full bg-[#D4AF37]/5 blur-3xl"
  ></div>

  <div class="relative mx-auto max-w-7xl">

    <!-- Encabezado -->
    <div class="max-w-3xl" data-reveal>

      <p class="mb-4 text-xs font-medium uppercase tracking-[0.3em] text-[#D4AF37]">
        Contacto
      </p>

      <h2
        class="text-4xl font-bold leading-tight tracking-tight text-white sm:text-5xl lg:text-6xl"
      >
        Hablemos de
        <span class="text-[#D4AF37]"> oportunidades.</span>
      </h2>

      <p class="mt-6 max-w-2xl text-base leading-7 text-white/50 sm:text-lg">
        Si necesitas asesoría, deseas conocer más sobre mi experiencia
        profesional o estás interesado en establecer una colaboración,
        puedes ponerte en contacto directamente.
      </p>

    </div>


    <!-- Contenido -->
    <div class="mt-16 grid gap-6 lg:grid-cols-5">


      <!-- Información -->
      <div
        class="rounded-xl border border-white/10 bg-black p-8 lg:col-span-2"
        data-reveal="left"
      >

        <p class="text-xs uppercase tracking-[0.2em] text-white/40">
          Información de contacto
        </p>


        <div class="mt-8 space-y-7">


          <!-- Email -->
          <a
            href="mailto:sebasguerra25@gmail.com"
            class="group flex items-start gap-4"
          >
            <div
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg border border-white/10 text-[#D4AF37] transition-colors group-hover:border-[#D4AF37]/50"
            >
              @
            </div>

            <div>
              <p class="text-xs uppercase tracking-wider text-white/30">
                Email
              </p>

              <p
                class="mt-1 text-sm text-white/70 transition-colors group-hover:text-[#D4AF37]"
              >
                sebasguerra25@gmail.com
              </p>
            </div>
          </a>

          <!-- WhatsApp -->
          <a
            href="https://wa.me/573005097039"
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-start gap-4"
          >
            <div
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg border border-white/10 text-[#D4AF37] transition-colors group-hover:border-[#D4AF37]/50"
            >
              ↗
            </div>

            <div>
              <p class="text-xs uppercase tracking-wider text-white/30">
                WhatsApp
              </p>

              <p
                class="mt-1 text-sm text-white/70 transition-colors group-hover:text-[#D4AF37]"
              >
                +57 300 509 7039
              </p>
            </div>
          </a>


          <!-- Ubicación -->
          <div class="flex items-start gap-4">

            <div
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg border border-white/10 text-[#D4AF37]"
            >
              +
            </div>

            <div>

              <p class="text-xs uppercase tracking-wider text-white/30">
                Ubicación
              </p>

              <p class="mt-1 text-sm text-white/70">
                Colombia
              </p>

            </div>

          </div>

        </div>


        <!-- Redes -->
        <div class="mt-10 border-t border-white/10 pt-7">

          <p class="mb-4 text-xs uppercase tracking-[0.2em] text-white/30">
            Redes profesionales
          </p>

          <div class="flex gap-3">

            <a
              href="https://www.linkedin.com/in/juan-sebastian-guerra-diaz-b365872b3/"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="LinkedIn"
              class="inline-flex h-15 items-center justify-center gap-10 rounded border border-[#0A66C2]/40 bg-[#0A66C2]/5 px-4 text-sm font-medium text-[#0A66C2] transition-all duration-300 hover:border-[#0A66C2] hover:bg-[#0A66C2]/10"
            >
              <span class="font-bold">in</span>
              <span>LinkedIn</span>
            </a>

          </div>

        </div>

      </div>


      <!-- Formulario -->
      <div
        class="rounded-xl border border-white/10 bg-black p-8 lg:col-span-3"
        data-reveal="right"
      >

        <div class="mb-8">

          <p class="text-xs uppercase tracking-[0.2em] text-[#D4AF37]">
            Envíame un mensaje
          </p>

          <h3 class="mt-2 text-2xl font-semibold text-white">
            ¿Cómo podemos ayudarte?
          </h3>

          <p class="mt-3 text-sm leading-6 text-white/40">
            Cuéntame brevemente sobre tu necesidad y me pondré en contacto
            contigo.
          </p>

        </div>


        <form id="contact-form" class="space-y-6">

        <div class="grid gap-6 sm:grid-cols-2">

          <!-- Nombre -->
          <div>
            <label
              for="nombre"
              class="mb-2 block text-xs uppercase tracking-wider text-white/40"
            >
              Nombre *
            </label>

            <input
              id="nombre"
              name="nombre"
              type="text"
              required
              placeholder="Tu nombre"
              class="w-full rounded border border-white/10 bg-[#0D0D0D] px-4 py-3 text-sm text-white outline-none transition focus:border-[#D4AF37]/60 placeholder:text-white/20"
            />
          </div>


          <!-- Email -->
          <div>
            <label
              for="email"
              class="mb-2 block text-xs uppercase tracking-wider text-white/40"
            >
              Email *
            </label>

            <input
              id="email"
              name="email"
              type="email"
              required
              placeholder="tu@email.com"
              class="w-full rounded border border-white/10 bg-[#0D0D0D] px-4 py-3 text-sm text-white outline-none transition focus:border-[#D4AF37]/60 placeholder:text-white/20"
            />
          </div>

        </div>


        <!-- Empresa -->
        <div>
          <label
            for="empresa"
            class="mb-2 block text-xs uppercase tracking-wider text-white/40"
          >
            Empresa / Organización
          </label>

          <input
            id="empresa"
            name="empresa"
            type="text"
            placeholder="Nombre de la empresa u organización"
            class="w-full rounded border border-white/10 bg-[#0D0D0D] px-4 py-3 text-sm text-white outline-none transition focus:border-[#D4AF37]/60 placeholder:text-white/20"
          />
        </div>


        <!-- Motivo -->
        <div>
          <label
            for="motivo"
            class="mb-2 block text-xs uppercase tracking-wider text-white/40"
          >
            Motivo de contacto *
          </label>

          <select
            id="motivo"
            name="motivo"
            required
            class="w-full rounded border border-white/10 bg-[#0D0D0D] px-4 py-3 text-sm text-white/70 outline-none transition focus:border-[#D4AF37]/60"
          >

            <option value="" selected disabled>
              Selecciona una opción
            </option>

            <option value="Proceso de licitación">
              Proceso de licitación
            </option>

            <option value="Propuesta técnica o económica">
              Propuesta técnica o económica
            </option>

            <option value="Contratación">
              Contratación
            </option>

            <option value="Asesoría profesional">
              Asesoría profesional
            </option>

            <option value="Colaboración">
              Colaboración
            </option>

            <option value="Otro">
              Otro
            </option>

          </select>
        </div>


        <!-- Mensaje -->
        <div>
          <label
            for="mensaje"
            class="mb-2 block text-xs uppercase tracking-wider text-white/40"
          >
            Mensaje *
          </label>

          <textarea
            id="mensaje"
            name="mensaje"
            rows="5"
            required
            placeholder="Cuéntame brevemente sobre tu necesidad..."
            class="w-full resize-none rounded border border-white/10 bg-[#0D0D0D] px-4 py-3 text-sm text-white outline-none transition focus:border-[#D4AF37]/60 placeholder:text-white/20"
          ></textarea>
        </div>


        <!-- Botón -->
        <button
          type="submit"
          class="group inline-flex w-full items-center justify-center gap-3 rounded bg-[#D4AF37] px-6 py-4 text-sm font-semibold text-black transition-all duration-300 hover:-translate-y-1 hover:bg-[#F0D477] hover:shadow-lg hover:shadow-[#D4AF37]/10"
        >

          <span id="button-text">
            Enviar mensaje
          </span>

          <span
            class="transition-transform duration-300 group-hover:translate-x-1"
          >
            →
          </span>

        </button>

      </form>
      <script>
        const form = document.getElementById("contact-form");

        form?.addEventListener("submit", (event) => {
          event.preventDefault();

          const nombre = document.getElementById("nombre").value.trim();
          const email = document.getElementById("email").value.trim();
          const empresa = document.getElementById("empresa").value.trim();
          const motivo = document.getElementById("motivo").value;
          const mensaje = document.getElementById("mensaje").value.trim();

          const numeroWhatsApp = "573005097039";

          const texto = `
- Hola, soy ${nombre}.

Quisiera ponerme en contacto contigo.

• Email: ${email}
• Empresa/Organización: ${empresa || "No especificada"}
• Motivo: ${motivo}

• Mensaje:
${mensaje}
          `.trim();

          const url = `https://wa.me/${numeroWhatsApp}?text=${encodeURIComponent(texto)}`;

          window.open(url, "_blank");
        });
      </script>
      </div>

    </div>

  </div>
</section>