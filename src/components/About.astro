---
---

<section
  id="sobre-mi"
  class="relative bg-black px-6 py-28 lg:px-8"
>
  <div class="mx-auto max-w-7xl">

    <!-- ========================================== -->
    <!-- ENCABEZADO -->
    <!-- ========================================== -->

    <div
      class="mb-16 flex flex-col gap-6 md:flex-row md:items-end md:justify-between"
    >

      <div>

        <p
          class="mb-3 text-xs font-medium uppercase tracking-[0.3em] text-[#D4AF37]"
        >
          Sobre mí
        </p>

        <h2
          class="max-w-3xl text-4xl font-bold tracking-tight text-white sm:text-5xl"
        >
          Experiencia en
          <span class="text-[#D4AF37]"> licitaciones y contratación.</span>
        </h2>

      </div>


      <p class="max-w-md text-sm leading-6 text-white/50">
        Profesional especializado en la gestión de procesos de licitación,
        elaboración de propuestas y seguimiento contractual en el sector
        público y privado en Colombia.
      </p>

    </div>


    <!-- ========================================== -->
    <!-- CONTENIDO -->
    <!-- ========================================== -->

    <div class="grid gap-12 lg:grid-cols-5">


      <!-- ========================================== -->
      <!-- IMAGEN -->
      <!-- ========================================== -->

      <div class="lg:col-span-2">

        <div class="relative mx-auto max-w-md">

          <!-- Marco principal -->

          <div
            class="aspect-[4/5] overflow-hidden rounded-xl border border-[#D4AF37]/20 bg-[#0D0D0D] shadow-2xl shadow-black/50 transition-all duration-500 hover:border-[#D4AF37]/40 hover:shadow-[#D4AF37]/5"
          >

            <img
              src="/images/perfil.png"
              alt="Juan Sebastián Guerra Díaz - Analista de Licitaciones"
              class="h-full w-full object-cover grayscale transition duration-700 hover:scale-105 hover:grayscale-0"
            />

            <!-- Overlay -->

            <div
              class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent"
            ></div>

          </div>


          <!-- Decoración inferior -->

          <div
            class="absolute -bottom-4 -left-4 h-24 w-24 border-b border-l border-[#D4AF37]/50"
          ></div>


          <!-- Decoración superior -->

          <div
            class="absolute -right-4 -top-4 h-24 w-24 border-r border-t border-[#D4AF37]/50"
          ></div>


          <!-- Etiqueta flotante -->

          <div
            class="absolute bottom-6 left-6 right-6 rounded-lg border border-[#D4AF37]/30 bg-black/80 p-4 shadow-2xl backdrop-blur-md"
          >

            <p
              class="text-xs uppercase tracking-[0.2em] text-[#D4AF37]"
            >
              Perfil profesional
            </p>

            <p class="mt-1 text-sm text-white/70">
              Analista de Licitaciones
            </p>

          </div>

        </div>

      </div>


      <!-- ========================================== -->
      <!-- INFORMACIÓN -->
      <!-- ========================================== -->

      <div
        class="flex flex-col justify-center lg:col-span-3"
      >

        <!-- Descripción principal -->

        <p class="text-lg leading-8 text-white/70">
          Profesional con más de 4 años de experiencia en la gestión de
          procesos de licitación en el sector público y privado en Colombia,
          especializado en la elaboración de propuestas técnicas y económicas,
          análisis de pliegos y formulación de presupuestos.
        </p>


        <p class="mt-6 text-base leading-7 text-white/50">
          Mi experiencia comprende la identificación de oportunidades,
          preparación y presentación de ofertas, gestión documental,
          seguimiento de procesos contractuales y actualización del Registro
          Único de Proponentes (RUP), con especial atención al cumplimiento
          de requisitos administrativos, técnicos y legales.
        </p>


        <!-- ========================================== -->
        <!-- ESTADÍSTICAS -->
        <!-- ========================================== -->

        <div
          class="mt-10 grid grid-cols-2 gap-6 border-y border-white/10 py-8 sm:grid-cols-3"
        >

          <!-- Experiencia -->

          <div>

            <p class="text-3xl font-bold text-[#D4AF37]">
              4+
            </p>

            <p
              class="mt-2 text-xs uppercase tracking-wider text-white/40"
            >
              Años de experiencia
            </p>

          </div>


          <!-- Sectores -->

          <div>

            <p class="text-3xl font-bold text-[#D4AF37]">
              2
            </p>

            <p
              class="mt-2 text-xs uppercase tracking-wider text-white/40"
            >
              Sectores
            </p>

          </div>


          <!-- Plataformas -->

          <div>

            <p class="text-3xl font-bold text-[#D4AF37]">
              8+
            </p>

            <p
              class="mt-2 text-xs uppercase tracking-wider text-white/40"
            >
              Plataformas de contratación
            </p>

          </div>

        </div>


        <!-- ========================================== -->
        <!-- ESPECIALIDADES -->
        <!-- ========================================== -->

        <div class="mt-8">

          <p
            class="mb-4 text-xs uppercase tracking-[0.2em] text-white/40"
          >
            Áreas de especialización
          </p>


          <div class="flex flex-wrap gap-2">

            <span
              class="rounded border border-white/10 bg-white/[0.02] px-3 py-2 text-xs text-white/60 transition-all duration-300 hover:-translate-y-1 hover:border-[#D4AF37]/40 hover:bg-[#D4AF37]/5 hover:text-[#D4AF37]"
            >
              Análisis de pliegos
            </span>


            <span
              class="rounded border border-white/10 bg-white/[0.02] px-3 py-2 text-xs text-white/60 transition-all duration-300 hover:-translate-y-1 hover:border-[#D4AF37]/40 hover:bg-[#D4AF37]/5 hover:text-[#D4AF37]"
            >
              Propuestas técnicas
            </span>


            <span
              class="rounded border border-white/10 bg-white/[0.02] px-3 py-2 text-xs text-white/60 transition-all duration-300 hover:-translate-y-1 hover:border-[#D4AF37]/40 hover:bg-[#D4AF37]/5 hover:text-[#D4AF37]"
            >
              Propuestas económicas
            </span>


            <span
              class="rounded border border-white/10 bg-white/[0.02] px-3 py-2 text-xs text-white/60 transition-all duration-300 hover:-translate-y-1 hover:border-[#D4AF37]/40 hover:bg-[#D4AF37]/5 hover:text-[#D4AF37]"
            >
              Contratación estatal
            </span>


            <span
              class="rounded border border-white/10 bg-white/[0.02] px-3 py-2 text-xs text-white/60 transition-all duration-300 hover:-translate-y-1 hover:border-[#D4AF37]/40 hover:bg-[#D4AF37]/5 hover:text-[#D4AF37]"
            >
              Gestión del RUP
            </span>


            <span
              class="rounded border border-white/10 bg-white/[0.02] px-3 py-2 text-xs text-white/60 transition-all duration-300 hover:-translate-y-1 hover:border-[#D4AF37]/40 hover:bg-[#D4AF37]/5 hover:text-[#D4AF37]"
            >
              Gestión contractual
            </span>


            <span
              class="rounded border border-white/10 bg-white/[0.02] px-3 py-2 text-xs text-white/60 transition-all duration-300 hover:-translate-y-1 hover:border-[#D4AF37]/40 hover:bg-[#D4AF37]/5 hover:text-[#D4AF37]"
            >
              Presupuestos
            </span>


            <span
              class="rounded border border-white/10 bg-white/[0.02] px-3 py-2 text-xs text-white/60 transition-all duration-300 hover:-translate-y-1 hover:border-[#D4AF37]/40 hover:bg-[#D4AF37]/5 hover:text-[#D4AF37]"
            >
              Gestión documental
            </span>

          </div>

        </div>

      </div>

    </div>

  </div>
</section>