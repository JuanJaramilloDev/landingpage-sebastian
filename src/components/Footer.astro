---
---

<footer class="border-t border-white/10 bg-black px-6 py-10 lg:px-8">

  <div
    class="mx-auto flex max-w-7xl flex-col gap-8 md:flex-row md:items-center md:justify-between"
  >

    <!-- Marca -->
    <div>

      <button
        type="button"
        data-scroll="inicio"
        class="text-lg font-bold tracking-wide text-[#D4AF37]"
      >
        Sebastián Guerra
      </button>

      <p class="mt-2 text-xs text-white/30">
        Ingeniería Biomédica · Licitaciones · Gestión
      </p>

    </div>


    <!-- Navegación -->
    <nav class="flex flex-wrap gap-x-6 gap-y-3">

      <button
        type="button"
        data-scroll="inicio"
        class="text-xs text-white/40 transition-colors hover:text-[#D4AF37]"
      >
        Inicio
      </button>

      <button
        type="button"
        data-scroll="sobre-mi"
        class="text-xs text-white/40 transition-colors hover:text-[#D4AF37]"
      >
        Sobre mí
      </button>

      <button
        type="button"
        data-scroll="experiencia"
        class="text-xs text-white/40 transition-colors hover:text-[#D4AF37]"
      >
        Experiencia
      </button>

      <button
        type="button"
        data-scroll="proyectos"
        class="text-xs text-white/40 transition-colors hover:text-[#D4AF37]"
      >
        Especialidades
      </button>

      <button
        type="button"
        data-scroll="contacto"
        class="text-xs text-white/40 transition-colors hover:text-[#D4AF37]"
      >
        Contacto
      </button>

    </nav>

  </div>


  <!-- Copyright -->
  <div class="mx-auto mt-8 max-w-7xl border-t border-white/5 pt-6">

    <div class="flex flex-col gap-3 text-center md:flex-row md:items-center md:justify-between">

      <p class="text-xs text-white/25">
        © 2026 Sebastián Guerra. Todos los derechos reservados.
      </p>

      <p class="text-xs text-white/20">
        Ingeniero Biomédico
      </p>

    </div>

  </div>

</footer>