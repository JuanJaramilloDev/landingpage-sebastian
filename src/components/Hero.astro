---
---

<section
  id="inicio"
  class="relative flex min-h-screen items-center overflow-hidden bg-black px-6 pt-4"
>
  <!-- ========================================== -->
  <!-- DETALLES DECORATIVOS DE FONDO -->
  <!-- ========================================== -->

  <div
    class="animate-float-slow absolute -left-40 top-1/4 h-80 w-80 rounded-full bg-[#D4AF37]/5 blur-3xl"
  ></div>

  <div
    class="animate-float-slow absolute -right-40 bottom-0 h-96 w-96 rounded-full bg-[#D4AF37]/5 blur-3xl"
    style="animation-delay: -3s;"
  ></div>


  <div
    class="mx-auto grid w-full max-w-7xl items-center gap-16 py-20 lg:grid-cols-2"
  >

    <!-- ========================================== -->
    <!-- CONTENIDO -->
    <!-- ========================================== -->

    <div class="relative z-10">

      <!-- Etiqueta -->
      <div
        class="mb-6 inline-flex items-center gap-2 rounded-full border border-[#D4AF37]/30 bg-[#D4AF37]/5 px-4 py-2 transition-all duration-300 hover:border-[#D4AF37]/60 hover:bg-[#D4AF37]/10"
        data-reveal
      >

        <span
          class="h-2 w-2 rounded-full bg-[#D4AF37] shadow-[0_0_10px_rgba(212,175,55,0.7)]"
        ></span>

        <span
          class="text-xs font-medium uppercase tracking-[0.2em] text-[#D4AF37]"
        >
          Analista de Licitaciones
        </span>

      </div>


      <!-- ========================================== -->
      <!-- TÍTULO -->
      <!-- ========================================== -->

      <h1
        class="max-w-3xl text-5xl font-bold leading-[1.05] tracking-tight text-white sm:text-6xl lg:text-7xl"
        data-reveal
        data-reveal-delay="1"
      >

        Licitaciones,

        <span class="block text-[#D4AF37]">
          contratación y estrategia.
        </span>

      </h1>


      <!-- ========================================== -->
      <!-- DESCRIPCIÓN -->
      <!-- ========================================== -->

      <p
        class="mt-7 max-w-xl text-base leading-7 text-white/60 sm:text-lg"
        data-reveal
        data-reveal-delay="2"
      >
        Profesional con más de 5 años de experiencia en la gestión de
        procesos de licitación en el sector público y privado en Colombia,
        especializado en propuestas técnicas y económicas, análisis de
        pliegos, presupuestos y seguimiento contractual.
      </p>


      <!-- ========================================== -->
      <!-- BOTONES -->
      <!-- ========================================== -->

      <div
        class="mt-10 flex flex-wrap gap-4"
        data-reveal
        data-reveal-delay="3"
      >

        <!-- Ver experiencia -->
        <button
          type="button"
          data-scroll="servicios"
          class="group inline-flex items-center gap-3 rounded bg-[#D4AF37] px-6 py-3.5 text-sm font-semibold text-black shadow-lg shadow-[#D4AF37]/5 transition-all duration-300 hover:-translate-y-1 hover:bg-[#F0D477] hover:shadow-xl hover:shadow-[#D4AF37]/10"
        >

          Ver Servicios

          <span
            class="transition-transform duration-300 group-hover:translate-x-1"
          >
            →
          </span>

        </button>


        <!-- WhatsApp -->
        <a
          href="https://wa.me/573005097039?text=Hola%20Sebasti%C3%A1n,%20vi%20tu%20perfil%20y%20me%20gustar%C3%ADa%20conocer%20m%C3%A1s%20sobre%20tus%20servicios%20en%20licitaciones%2C%20contrataci%C3%B3n%20y%20gesti%C3%B3n%20de%20procesos."
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded border border-white/20 px-6 py-3.5 text-sm font-semibold text-white transition-all duration-300 hover:-translate-y-1 hover:border-[#D4AF37] hover:bg-[#D4AF37]/5 hover:text-[#D4AF37]"
        >
          <!-- Icono WhatsApp -->
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path
              d="M21 11.5a8.38 8.38 0 0 1-9 9 8.5 8.5 0 0 1-4-.9L3 21l1.4-4.8a8.5 8.5 0 1 1 16.6-4.7Z"
            ></path>

            <path
              d="M8.5 9.5c.2 1.5 1.8 3.3 3.5 4.2 1.2.6 2.1.8 2.7.2l.8-.9"
            ></path>
          </svg>

          WhatsApp

        </a>
      
      </div>


      <!-- ========================================== -->
      <!-- ÁREAS DE ESPECIALIZACIÓN -->
      <!-- ========================================== -->

      <div
        class="mt-14 border-t border-white/10 pt-6"
        data-reveal
        data-reveal-delay="3"
      >

        <p class="mb-4 text-xs uppercase tracking-[0.2em] text-white/40">
          Áreas de especialización
        </p>


        <div class="flex flex-wrap gap-3">

          <!-- Licitaciones -->
          <span
            class="cursor-default rounded border border-white/10 bg-white/[0.02] px-3 py-1.5 text-xs text-white/60 transition-all duration-300 hover:-translate-y-1 hover:border-[#D4AF37]/40 hover:bg-[#D4AF37]/5 hover:text-[#D4AF37]"
          >
            Licitaciones
          </span>


          <!-- Propuestas -->
          <span
            class="cursor-default rounded border border-white/10 bg-white/[0.02] px-3 py-1.5 text-xs text-white/60 transition-all duration-300 hover:-translate-y-1 hover:border-[#D4AF37]/40 hover:bg-[#D4AF37]/5 hover:text-[#D4AF37]"
          >
            Propuestas Técnicas y Económicas
          </span>


          <!-- Contratación -->
          <span
            class="cursor-default rounded border border-white/10 bg-white/[0.02] px-3 py-1.5 text-xs text-white/60 transition-all duration-300 hover:-translate-y-1 hover:border-[#D4AF37]/40 hover:bg-[#D4AF37]/5 hover:text-[#D4AF37]"
          >
            Contratación Estatal
          </span>


          <!-- SECOP -->
          <span
            class="cursor-default rounded border border-white/10 bg-white/[0.02] px-3 py-1.5 text-xs text-white/60 transition-all duration-300 hover:-translate-y-1 hover:border-[#D4AF37]/40 hover:bg-[#D4AF37]/5 hover:text-[#D4AF37]"
          >
            SECOP I · SECOP II
          </span>

        </div>

      </div>

    </div>


    <!-- ========================================== -->
    <!-- ELEMENTO VISUAL -->
    <!-- ========================================== -->

    <div
      class="relative flex items-center justify-center lg:justify-end"
      data-reveal
      data-reveal-delay="2"
    >

      <!-- Halo dorado -->
      <div
        class="animate-float absolute h-72 w-72 rounded-full bg-[#D4AF37]/10 blur-[100px]"
      ></div>

      <div
        class="animate-float absolute h-40 w-40 rounded-full bg-[#D4AF37]/10 blur-[70px]"
        style="animation-delay: -2s;"
      ></div>


      <!-- ========================================== -->
      <!-- MARCO EXTERIOR -->
      <!-- ========================================== -->

      <div
        class="relative aspect-square w-full max-w-lg overflow-hidden rounded-2xl border border-[#D4AF37]/20 bg-[#0D0D0D] shadow-2xl shadow-black/50 transition-all duration-700 hover:border-[#D4AF37]/50 hover:shadow-[#D4AF37]/5"
      >

        <!-- Línea decorativa interior -->
        <div
          class="pointer-events-none absolute inset-3 z-10 rounded-xl border border-[#D4AF37]/10"
        ></div>


        <!-- ========================================== -->
        <!-- IMAGEN -->
        <!-- ========================================== -->

        <div
          class="absolute inset-5 overflow-hidden rounded-xl border border-white/10"
        >

          <img
            src="/images/foto1.png"
            alt="Juan Sebastián Guerra - Analista de Licitaciones"
            class="h-full w-full object-cover opacity-80 grayscale transition duration-700 hover:scale-105 hover:grayscale-0"
          />


          <!-- Overlay -->
          <div
            class="absolute inset-0 bg-gradient-to-t from-black via-black/20 to-transparent"
          ></div>


          <!-- Brillo lateral -->
          <div
            class="pointer-events-none absolute inset-y-0 left-0 w-1/3 bg-gradient-to-r from-[#D4AF37]/5 to-transparent"
          ></div>

        </div>


        <!-- ========================================== -->
        <!-- TARJETA FLOTANTE -->
        <!-- ========================================== -->

        <div
          class="animate-float absolute bottom-10 left-10 right-10 rounded-lg border border-[#D4AF37]/30 bg-black/80 p-5 shadow-2xl shadow-black/50 backdrop-blur-md transition-all duration-500 hover:-translate-y-1 hover:border-[#D4AF37]/70 hover:shadow-[#D4AF37]/10"
        >

          <div class="flex items-center justify-between">

            <div>

              <p
                class="text-xs uppercase tracking-widest text-[#D4AF37]"
              >
                Gestión de Licitaciones
              </p>

              <p class="mt-1 text-sm text-white/70">
                Sector Público · Sector Privado · Contratación
              </p>

            </div>


            <!-- Elemento decorativo -->
            <div
              class="flex h-10 w-10 items-center justify-center rounded-full border border-[#D4AF37]/30 text-[#D4AF37] transition-all duration-300 hover:rotate-90 hover:border-[#D4AF37] hover:bg-[#D4AF37]/10 hover:shadow-[0_0_20px_rgba(212,175,55,0.15)]"
            >
              +
            </div>

          </div>

        </div>

      </div>


      <!-- ========================================== -->
      <!-- DECORACIONES EXTERIORES -->
      <!-- ========================================== -->

      <div
        class="absolute -right-3 top-10 h-20 w-20 border-r border-t border-[#D4AF37]/40 transition-all duration-500 hover:-translate-y-1 hover:border-[#D4AF37]"
      ></div>


      <div
        class="absolute -bottom-3 left-10 h-20 w-20 border-b border-l border-[#D4AF37]/40 transition-all duration-500 hover:translate-y-1 hover:border-[#D4AF37]"
      ></div>


      <div
        class="absolute -right-2 bottom-24 h-2 w-2 rounded-full bg-[#D4AF37] shadow-[0_0_12px_rgba(212,175,55,0.6)]"
      ></div>

    </div>

  </div>


  <!-- ========================================== -->
  <!-- INDICADOR DE SCROLL -->
  <!-- ========================================== -->

  <div
    class="absolute bottom-8 left-1/2 hidden -translate-x-1/2 flex-col items-center gap-3 md:flex"
  >

    <span
      class="text-[10px] uppercase tracking-[0.3em] text-white/30"
    >
      Scroll
    </span>

    <div
      class="relative h-10 w-px overflow-hidden bg-white/10"
    >

      <div
        class="animate-scroll-dot absolute left-0 top-0 h-1/2 w-full bg-[#D4AF37]"
      ></div>

    </div>

  </div>

</section>