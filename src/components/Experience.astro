---
---

<section
  id="como-trabajamos"
  class="border-t border-white/5 bg-[#080808] px-6 py-24 lg:px-8"
>
  <div class="mx-auto max-w-7xl">

    <!-- ========================================== -->
    <!-- ENCABEZADO -->
    <!-- ========================================== -->

    <div class="mb-20 max-w-3xl" data-reveal>

      <p
        class="mb-3 text-xs font-medium uppercase tracking-[0.3em] text-[#D4AF37]"
      >
        Cómo trabajamos
      </p>

      <h2
        class="text-4xl font-bold tracking-tight text-white sm:text-5xl"
      >
        Un proceso claro para
        <span class="text-[#D4AF37]"> tomar mejores decisiones.</span>
      </h2>

      <p class="mt-5 max-w-2xl text-sm leading-7 text-white/50 sm:text-base">
        Acompañamos cada oportunidad desde su identificación hasta el
        seguimiento del proceso, combinando análisis, estrategia y gestión
        para encontrar las mejores oportunidades de contratación.
      </p>

    </div>

    <!-- ========================================== -->
    <!-- PROCESO -->
    <!-- ========================================== -->

    <div class="relative">

      <!-- Línea central SOLO en escritorio -->
      <div
        class="absolute left-1/2 top-0 hidden h-full w-px
              -translate-x-1/2 bg-white/10 lg:block"
      ></div>


      <!-- ========================================== -->
      <!-- PASO 01 -->
      <!-- ========================================== -->

      <article
        class="group relative grid gap-6 lg:grid-cols-2 lg:gap-16"
        data-reveal
      >

        <!-- Contenido -->

        <div class="lg:pr-16 lg:text-right">

          <!-- Número -->
          <div
            class="mb-5 flex h-11 w-11 items-center justify-center
                  rounded-xl border border-[#D4AF37]/30
                  bg-[#0B0B0B] text-xs font-semibold text-[#D4AF37]
                  transition-all duration-300
                  group-hover:border-[#D4AF37]
                  group-hover:bg-[#D4AF37]
                  group-hover:text-black
                  lg:ml-auto"
          >
            01
          </div>

          <p
            class="text-xs font-medium uppercase tracking-[0.2em] text-[#D4AF37]"
          >
            Paso 01
          </p>

          <h3 class="mt-3 text-2xl font-semibold text-white sm:text-3xl">
            Identificamos
            <span class="text-white/40"> oportunidades.</span>
          </h3>

          <p class="mt-4 text-sm leading-7 text-white/50">
            Buscamos y filtramos procesos de contratación que puedan ser
            realmente relevantes para la empresa, teniendo en cuenta su
            perfil, capacidades y objetivos.
          </p>

        </div>

        <!-- Espacio visual -->

        <div class="hidden lg:block lg:pl-16">

          <div
            class="min-h-[150px] rounded-2xl border border-white/5
                  bg-white/[0.015] transition-all duration-500
                  group-hover:border-[#D4AF37]/20"
          ></div>

        </div>

      </article>

      <!-- ========================================== -->
      <!-- PASO 02 -->
      <!-- ========================================== -->

      <article
        class="group relative mt-16 grid gap-6
              lg:mt-24 lg:grid-cols-2 lg:gap-16"
        data-reveal
      >

        <!-- Espacio visual -->

        <div
          class="order-2 hidden lg:order-1 lg:block lg:pr-16"
        >

          <div
            class="min-h-[150px] rounded-2xl border border-white/5
                  bg-white/[0.015] transition-all duration-500
                  group-hover:border-[#D4AF37]/20"
          ></div>

        </div>

        <!-- Contenido -->

        <div class="order-1 lg:order-2 lg:pl-16">

          <!-- Número -->

          <div
            class="mb-5 flex h-11 w-11 items-center justify-center
                  rounded-xl border border-[#D4AF37]/30
                  bg-[#0B0B0B] text-xs font-semibold text-[#D4AF37]
                  transition-all duration-300
                  group-hover:border-[#D4AF37]
                  group-hover:bg-[#D4AF37]
                  group-hover:text-black"
          >
            02
          </div>

          <p
            class="text-xs font-medium uppercase tracking-[0.2em] text-[#D4AF37]"
          >
            Paso 02
          </p>

          <h3 class="mt-3 text-2xl font-semibold text-white sm:text-3xl">
            Analizamos
            <span class="text-white/40"> la oportunidad.</span>
          </h3>

          <p class="mt-4 text-sm leading-7 text-white/50">
            Revisamos los requisitos, condiciones, presupuesto, tiempos y
            criterios del proceso para determinar su viabilidad y definir
            la mejor estrategia de participación.
          </p>

        </div>

      </article>

      <!-- ========================================== -->
      <!-- PASO 03 -->
      <!-- ========================================== -->

      <article
        class="group relative mt-16 grid gap-6
              lg:mt-24 lg:grid-cols-2 lg:gap-16"
        data-reveal
      >

        <!-- Contenido -->

        <div class="lg:pr-16 lg:text-right">

          <!-- Número -->

          <div
            class="mb-5 flex h-11 w-11 items-center justify-center
                  rounded-xl border border-[#D4AF37]/30
                  bg-[#0B0B0B] text-xs font-semibold text-[#D4AF37]
                  transition-all duration-300
                  group-hover:border-[#D4AF37]
                  group-hover:bg-[#D4AF37]
                  group-hover:text-black
                  lg:ml-auto"
          >
            03
          </div>

          <p
            class="text-xs font-medium uppercase tracking-[0.2em] text-[#D4AF37]"
          >
            Paso 03
          </p>

          <h3 class="mt-3 text-2xl font-semibold text-white sm:text-3xl">
            Preparamos
            <span class="text-white/40"> la propuesta.</span>
          </h3>

          <p class="mt-4 text-sm leading-7 text-white/50">
            Estructuramos la documentación y los componentes técnicos y
            económicos necesarios para presentar una propuesta clara,
            organizada y alineada con los requerimientos del proceso.
          </p>

        </div>

        <!-- Espacio visual -->

        <div class="hidden lg:block lg:pl-16">

          <div
            class="min-h-[150px] rounded-2xl border border-white/5
                  bg-white/[0.015] transition-all duration-500
                  group-hover:border-[#D4AF37]/20"
          ></div>

        </div>

      </article>

      <!-- ========================================== -->
      <!-- PASO 04 -->
      <!-- ========================================== -->

      <article
        class="group relative mt-16 grid gap-6
              lg:mt-24 lg:grid-cols-2 lg:gap-16"
        data-reveal
      >

        <!-- Espacio visual -->

        <div
          class="order-2 hidden lg:order-1 lg:block lg:pr-16"
        >

          <div
            class="min-h-[150px] rounded-2xl border border-white/5
                  bg-white/[0.015] transition-all duration-500
                  group-hover:border-[#D4AF37]/20"
          ></div>

        </div>

        <!-- Contenido -->

        <div class="order-1 lg:order-2 lg:pl-16">

          <!-- Número -->

          <div
            class="mb-5 flex h-11 w-11 items-center justify-center
                  rounded-xl border border-[#D4AF37]/30
                  bg-[#0B0B0B] text-xs font-semibold text-[#D4AF37]
                  transition-all duration-300
                  group-hover:border-[#D4AF37]
                  group-hover:bg-[#D4AF37]
                  group-hover:text-black"
          >
            04
          </div>

          <p
            class="text-xs font-medium uppercase tracking-[0.2em] text-[#D4AF37]"
          >
            Paso 04
          </p>

          <h3 class="mt-3 text-2xl font-semibold text-white sm:text-3xl">
            Acompañamos
            <span class="text-white/40"> el proceso.</span>
          </h3>

          <p class="mt-4 text-sm leading-7 text-white/50">
            Realizamos seguimiento durante las diferentes etapas, desde la
            presentación hasta las fases posteriores, manteniendo una visión
            clara sobre avances, oportunidades y resultados.
          </p>

        </div>

      </article>

    </div>

    <!-- ========================================== -->
    <!-- ¿PARA QUIÉN ES? -->
    <!-- ========================================== -->

    <div
      class="mt-28 border-t border-white/10 pt-16"
    >

      <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:gap-20">

        <!-- Encabezado -->

        <div data-reveal="left">

          <p
            class="mb-3 text-xs font-medium uppercase tracking-[0.3em] text-[#D4AF37]"
          >
            ¿Para quién es?
          </p>

          <h3
            class="text-3xl font-bold tracking-tight text-white sm:text-4xl"
          >
            Oportunidades que
            <span class="text-[#D4AF37]"> requieren estrategia.</span>
          </h3>

          <p class="mt-5 max-w-lg text-sm leading-7 text-white/50">
            Un acompañamiento pensado para empresas que quieren participar
            en procesos de contratación de manera más estructurada,
            estratégica y eficiente.
          </p>

        </div>


        <!-- Lista -->

        <div class="divide-y divide-white/10 border-y border-white/10" data-reveal="right">

          <!-- Item 01 -->

          <div class="group flex items-start gap-5 py-5">

            <span
              class="mt-1 text-xs font-medium text-[#D4AF37]"
            >
              01
            </span>

            <p
              class="text-sm leading-6 text-white/60
                     transition-colors duration-300
                     group-hover:text-white"
            >
              Empresas que quieren comenzar a participar en licitaciones.
            </p>

          </div>


          <!-- Item 02 -->

          <div class="group flex items-start gap-5 py-5">

            <span
              class="mt-1 text-xs font-medium text-[#D4AF37]"
            >
              02
            </span>

            <p
              class="text-sm leading-6 text-white/60
                     transition-colors duration-300
                     group-hover:text-white"
            >
              Empresas que ya participan, pero no cuentan con tiempo para
              analizar oportunidades.
            </p>

          </div>


          <!-- Item 03 -->

          <div class="group flex items-start gap-5 py-5">

            <span
              class="mt-1 text-xs font-medium text-[#D4AF37]"
            >
              03
            </span>

            <p
              class="text-sm leading-6 text-white/60
                     transition-colors duration-300
                     group-hover:text-white"
            >
              Empresas que necesitan apoyo en la preparación de propuestas.
            </p>

          </div>


          <!-- Item 04 -->

          <div class="group flex items-start gap-5 py-5">

            <span
              class="mt-1 text-xs font-medium text-[#D4AF37]"
            >
              04
            </span>

            <p
              class="text-sm leading-6 text-white/60
                     transition-colors duration-300
                     group-hover:text-white"
            >
              Empresas que buscan ampliar sus oportunidades en el sector
              público y privado.
            </p>

          </div>


          <!-- Item 05 -->

          <div class="group flex items-start gap-5 py-5">

            <span
              class="mt-1 text-xs font-medium text-[#D4AF37]"
            >
              05
            </span>

            <p
              class="text-sm leading-6 text-white/60
                     transition-colors duration-300
                     group-hover:text-white"
            >
              Empresas que prefieren contar con acompañamiento especializado
              sin contratar personal adicional.
            </p>

          </div>

        </div>

      </div>

    </div>

  </div>
</section>
