---
---

<section
  id="experiencia"
  class="border-t border-white/5 bg-[#080808] px-6 py-28 lg:px-8"
>
  <div class="mx-auto max-w-7xl">

    <!-- Encabezado -->
    <div class="mb-20">

      <p class="mb-3 text-xs font-medium uppercase tracking-[0.3em] text-[#D4AF37]">
        Trayectoria
      </p>

      <h2 class="text-4xl font-bold tracking-tight text-white sm:text-5xl">
        Experiencia profesional
      </h2>

    </div>


    <!-- Timeline -->
    <div class="relative ml-3 border-l border-white/10">


      <!-- Experiencia 1 -->
      <article class="relative pb-16 pl-10 md:pl-16">

        <span
          class="absolute -left-[5px] top-1 h-2.5 w-2.5 rounded-full bg-[#D4AF37] ring-4 ring-[#080808]"
        ></span>

        <div class="grid gap-6 md:grid-cols-[180px_1fr]">

          <div>
            <p class="text-sm font-medium text-[#D4AF37]">
              Ene 2025 — Presente
            </p>
          </div>

          <div>

            <h3 class="text-xl font-semibold text-white">
              Analista de Licitaciones
            </h3>

            <p class="mt-1 text-sm text-white/40">
              ENFISA S.A.S.
            </p>

            <p class="mt-5 max-w-2xl text-sm leading-7 text-white/50">
              Liderazgo de procesos de licitación para la venta de
              dispositivos médicos al sector público y privado.
              Elaboración de propuestas técnicas y económicas, análisis
              de pliegos, preparación de presupuestos y gestión documental
              conforme a la normativa vigente.
            </p>

            <div class="mt-5 flex flex-wrap gap-2">

              <span class="rounded border border-white/10 px-3 py-1.5 text-xs text-white/40">
                SECOP I
              </span>

              <span class="rounded border border-white/10 px-3 py-1.5 text-xs text-white/40">
                SECOP II
              </span>

              <span class="rounded border border-white/10 px-3 py-1.5 text-xs text-white/40">
                Bionexo
              </span>

              <span class="rounded border border-white/10 px-3 py-1.5 text-xs text-white/40">
                Almera
              </span>

            </div>

          </div>

        </div>

      </article>


      <!-- Experiencia 2 -->
      <article class="relative pb-16 pl-10 md:pl-16">

        <span
          class="absolute -left-[5px] top-1 h-2.5 w-2.5 rounded-full border border-[#D4AF37] bg-[#080808] ring-4 ring-[#080808]"
        ></span>

        <div class="grid gap-6 md:grid-cols-[180px_1fr]">

          <div>
            <p class="text-sm font-medium text-[#D4AF37]">
              Jun 2024 — Ene 2025
            </p>
          </div>

          <div>

            <h3 class="text-xl font-semibold text-white">
              Key Account Manager Gobierno
            </h3>

            <p class="mt-1 text-sm text-white/40">
              IMS Mayorista S.A.S.
            </p>

            <p class="mt-5 max-w-2xl text-sm leading-7 text-white/50">
              Gestión de procesos de licitación para soluciones
              tecnológicas, incluyendo hardware, infraestructura de red
              y energía solar. Coordinación con áreas internas y
              proveedores para la preparación de propuestas competitivas
              y ajustadas a la normativa vigente.
            </p>

          </div>

        </div>

      </article>


      <!-- Experiencia 3 -->
      <article class="relative pb-16 pl-10 md:pl-16">

        <span
          class="absolute -left-[5px] top-1 h-2.5 w-2.5 rounded-full border border-[#D4AF37] bg-[#080808] ring-4 ring-[#080808]"
        ></span>

        <div class="grid gap-6 md:grid-cols-[180px_1fr]">

          <div>
            <p class="text-sm font-medium text-[#D4AF37]">
              Nov 2021 — Dic 2023
            </p>
          </div>

          <div>

            <h3 class="text-xl font-semibold text-white">
              Ingeniero Biomédico
            </h3>

            <p class="mt-1 text-sm text-white/40">
              Gobernación de Nariño
            </p>

            <p class="mt-5 max-w-2xl text-sm leading-7 text-white/50">
              Análisis técnico y estratégico para procesos de adquisición
              de equipos biomédicos, vehículos asistenciales y utilitarios
              para entidades del sector salud. Seguimiento a procesos de
              licitación, evaluación de propuestas y validación de
              especificaciones técnicas.
            </p>

          </div>

        </div>

      </article>


      <!-- Experiencia 4 -->
      <article class="relative pb-16 pl-10 md:pl-16">

        <span
          class="absolute -left-[5px] top-1 h-2.5 w-2.5 rounded-full border border-[#D4AF37] bg-[#080808] ring-4 ring-[#080808]"
        ></span>

        <div class="grid gap-6 md:grid-cols-[180px_1fr]">

          <div>
            <p class="text-sm font-medium text-[#D4AF37]">
              Oct 2019 — Oct 2020
            </p>
          </div>

          <div>

            <h3 class="text-xl font-semibold text-white">
              Ingeniero Biomédico
            </h3>

            <p class="mt-1 text-sm text-white/40">
              SINAPSIS S.A.S.
            </p>

            <p class="mt-5 max-w-2xl text-sm leading-7 text-white/50">
              Experiencia relacionada con la gestión y mantenimiento de
              equipos biomédicos, apoyando procesos técnicos y de
              seguimiento asociados a la tecnología hospitalaria.
            </p>

          </div>

        </div>

      </article>


      <!-- Experiencia 5 -->
      <article class="relative pl-10 md:pl-16">

        <span
          class="absolute -left-[5px] top-1 h-2.5 w-2.5 rounded-full border border-[#D4AF37] bg-[#080808] ring-4 ring-[#080808]"
        ></span>

        <div class="grid gap-6 md:grid-cols-[180px_1fr]">

          <div>
            <p class="text-sm font-medium text-[#D4AF37]">
              Jun 2019 — Sep 2019
            </p>
          </div>

          <div>

            <h3 class="text-xl font-semibold text-white">
              Ingeniero Biomédico
            </h3>

            <p class="mt-1 text-sm text-white/40">
              METROMED
            </p>

            <p class="mt-5 max-w-2xl text-sm leading-7 text-white/50">
              Actividades relacionadas con metrología biomédica,
              mantenimiento y seguimiento técnico de equipos,
              contribuyendo al control y gestión de tecnología
              hospitalaria.
            </p>

          </div>

        </div>

      </article>


    </div>

  </div>
</section>