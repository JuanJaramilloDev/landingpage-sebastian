---
---

<section
  id="servicios"
  class="border-t border-white/5 bg-black px-6 py-28 lg:px-8"
>
  <div class="mx-auto max-w-7xl">

    <!-- ========================================== -->
    <!-- ENCABEZADO -->
    <!-- ========================================== -->

    <div class="mb-16 max-w-4xl">

      <p
        class="mb-4 text-xs font-medium uppercase tracking-[0.3em] text-[#D4AF37]"
      >
        Servicios profesionales
      </p>

      <h2
        class="text-4xl font-bold tracking-tight text-white sm:text-5xl lg:text-6xl"
      >
        Soluciones para
        <span class="text-[#D4AF37]"> procesos de contratación.</span>
      </h2>

      <p class="mt-6 max-w-2xl text-base leading-7 text-white/50 sm:text-lg">
        Acompañamiento especializado para empresas que buscan participar en
        procesos de contratación pública y privada, estructurar propuestas
        competitivas y gestionar sus procesos de manera eficiente.
      </p>

    </div>


    <!-- ========================================== -->
    <!-- SERVICIOS -->
    <!-- ========================================== -->

    <div class="grid gap-5 md:grid-cols-2">


      <!-- ========================================== -->
      <!-- SERVICIO 01 -->
      <!-- ========================================== -->

      <article
        class="group relative overflow-hidden rounded-2xl border border-white/10
               bg-[#0B0B0B] p-7 transition-all duration-500
               hover:-translate-y-1 hover:border-[#D4AF37]/40
               hover:shadow-xl hover:shadow-black/30
               sm:p-8"
      >

        <!-- Número -->
        <div class="flex items-start justify-between">

          <span
            class="text-xs font-medium tracking-[0.2em] text-[#D4AF37]"
          >
            01
          </span>

          <!-- Imagen pequeña -->
          <div
            class="flex h-14 w-14 items-center justify-center overflow-hidden
                   rounded-xl border border-white/10 bg-white/[0.03]
                   transition duration-500
                   group-hover:border-[#D4AF37]/40"
          >
            <img
              src="/images/tarjeta1.png"
              alt="Asesoría en licitaciones"
              class="h-full w-full object-cover grayscale
                     transition duration-500 group-hover:grayscale-0"
            />
          </div>

        </div>


        <!-- Contenido -->

        <div class="mt-8">

          <h3
            class="text-2xl font-semibold tracking-tight text-white"
          >
            Asesoría en Licitaciones
          </h3>

          <p
            class="mt-4 max-w-xl text-sm leading-6 text-white/50"
          >
            Acompañamiento en la identificación y análisis de oportunidades
            de contratación, revisión de requisitos y preparación estratégica
            para participar en procesos de licitación.
          </p>


          <!-- Servicios incluidos -->

          <div class="mt-7 grid gap-3 sm:grid-cols-2">

            <div class="flex items-center gap-3 text-sm text-white/60">
              <span class="text-[#D4AF37]">✓</span>
              Identificación de oportunidades
            </div>

            <div class="flex items-center gap-3 text-sm text-white/60">
              <span class="text-[#D4AF37]">✓</span>
              Análisis de procesos
            </div>

            <div class="flex items-center gap-3 text-sm text-white/60">
              <span class="text-[#D4AF37]">✓</span>
              Revisión de requisitos
            </div>

            <div class="flex items-center gap-3 text-sm text-white/60">
              <span class="text-[#D4AF37]">✓</span>
              Seguimiento de oportunidades
            </div>

          </div>

        </div>

      </article>


      <!-- ========================================== -->
      <!-- SERVICIO 02 -->
      <!-- ========================================== -->

      <article
        class="group relative overflow-hidden rounded-2xl border border-white/10
               bg-[#0B0B0B] p-7 transition-all duration-500
               hover:-translate-y-1 hover:border-[#D4AF37]/40
               hover:shadow-xl hover:shadow-black/30
               sm:p-8"
      >

        <div class="flex items-start justify-between">

          <span
            class="text-xs font-medium tracking-[0.2em] text-[#D4AF37]"
          >
            02
          </span>

          <div
            class="flex h-14 w-14 items-center justify-center overflow-hidden
                   rounded-xl border border-white/10 bg-white/[0.03]
                   transition duration-500
                   group-hover:border-[#D4AF37]/40"
          >
            <img
              src="/images/tarjeta2.png"
              alt="Elaboración de propuestas"
              class="h-full w-full object-cover grayscale
                     transition duration-500 group-hover:grayscale-0"
            />
          </div>

        </div>


        <div class="mt-8">

          <h3
            class="text-2xl font-semibold tracking-tight text-white"
          >
            Elaboración de Propuestas
          </h3>

          <p
            class="mt-4 max-w-xl text-sm leading-6 text-white/50"
          >
            Estructuración y revisión de propuestas técnicas y económicas,
            buscando presentar ofertas claras, completas y competitivas de
            acuerdo con los requerimientos de cada proceso.
          </p>


          <div class="mt-7 grid gap-3 sm:grid-cols-2">

            <div class="flex items-center gap-3 text-sm text-white/60">
              <span class="text-[#D4AF37]">✓</span>
              Propuestas técnicas
            </div>

            <div class="flex items-center gap-3 text-sm text-white/60">
              <span class="text-[#D4AF37]">✓</span>
              Propuestas económicas
            </div>

            <div class="flex items-center gap-3 text-sm text-white/60">
              <span class="text-[#D4AF37]">✓</span>
              Elaboración de presupuestos
            </div>

            <div class="flex items-center gap-3 text-sm text-white/60">
              <span class="text-[#D4AF37]">✓</span>
              Revisión documental
            </div>

          </div>

        </div>

      </article>


      <!-- ========================================== -->
      <!-- SERVICIO 03 -->
      <!-- ========================================== -->

      <article
        class="group relative overflow-hidden rounded-2xl border border-white/10
               bg-[#0B0B0B] p-7 transition-all duration-500
               hover:-translate-y-1 hover:border-[#D4AF37]/40
               hover:shadow-xl hover:shadow-black/30
               sm:p-8"
      >

        <div class="flex items-start justify-between">

          <span
            class="text-xs font-medium tracking-[0.2em] text-[#D4AF37]"
          >
            03
          </span>

          <div
            class="flex h-14 w-14 items-center justify-center overflow-hidden
                   rounded-xl border border-white/10 bg-white/[0.03]
                   transition duration-500
                   group-hover:border-[#D4AF37]/40"
          >
            <img
              src="/images/tarjeta3.png"
              alt="Gestión contractual"
              class="h-full w-full object-cover grayscale
                     transition duration-500 group-hover:grayscale-0"
            />
          </div>

        </div>


        <div class="mt-8">

          <h3
            class="text-2xl font-semibold tracking-tight text-white"
          >
            Contratación y Gestión Contractual
          </h3>

          <p
            class="mt-4 max-w-xl text-sm leading-6 text-white/50"
          >
            Apoyo en procesos de contratación pública y privada, gestión
            documental y seguimiento de las diferentes etapas del proceso
            contractual.
          </p>


          <div class="mt-7 grid gap-3 sm:grid-cols-2">

            <div class="flex items-center gap-3 text-sm text-white/60">
              <span class="text-[#D4AF37]">✓</span>
              Análisis de pliegos
            </div>

            <div class="flex items-center gap-3 text-sm text-white/60">
              <span class="text-[#D4AF37]">✓</span>
              Contratación estatal
            </div>

            <div class="flex items-center gap-3 text-sm text-white/60">
              <span class="text-[#D4AF37]">✓</span>
              Gestión documental
            </div>

            <div class="flex items-center gap-3 text-sm text-white/60">
              <span class="text-[#D4AF37]">✓</span>
              Seguimiento contractual
            </div>

          </div>

        </div>

      </article>


      <!-- ========================================== -->
      <!-- SERVICIO 04 -->
      <!-- ========================================== -->

      <article
        class="group relative overflow-hidden rounded-2xl border border-white/10
               bg-[#0B0B0B] p-7 transition-all duration-500
               hover:-translate-y-1 hover:border-[#D4AF37]/40
               hover:shadow-xl hover:shadow-black/30
               sm:p-8"
      >

        <div class="flex items-start justify-between">

          <span
            class="text-xs font-medium tracking-[0.2em] text-[#D4AF37]"
          >
            04
          </span>

          <div
            class="flex h-14 w-14 items-center justify-center overflow-hidden
                   rounded-xl border border-white/10 bg-white/[0.03]
                   transition duration-500
                   group-hover:border-[#D4AF37]/40"
          >
            <img
              src="/images/tarjeta4.png"
              alt="Gestión de plataformas de contratación"
              class="h-full w-full object-cover grayscale
                     transition duration-500 group-hover:grayscale-0"
            />
          </div>

        </div>


        <div class="mt-8">

          <h3
            class="text-2xl font-semibold tracking-tight text-white"
          >
            Gestión en Plataformas de Contratación
          </h3>

          <p
            class="mt-4 max-w-xl text-sm leading-6 text-white/50"
          >
            Manejo de plataformas utilizadas para la búsqueda, participación
            y seguimiento de oportunidades de contratación pública y privada.
          </p>


          <div class="mt-7 flex flex-wrap gap-2">

            <span
              class="rounded-lg border border-white/10 bg-white/[0.03]
                     px-3 py-2 text-xs text-white/60
                     transition hover:border-[#D4AF37]/40 hover:text-white"
            >
              SECOP I
            </span>

            <span
              class="rounded-lg border border-white/10 bg-white/[0.03]
                     px-3 py-2 text-xs text-white/60
                     transition hover:border-[#D4AF37]/40 hover:text-white"
            >
              SECOP II
            </span>

            <span
              class="rounded-lg border border-white/10 bg-white/[0.03]
                     px-3 py-2 text-xs text-white/60
                     transition hover:border-[#D4AF37]/40 hover:text-white"
            >
              TVEC
            </span>

            <span
              class="rounded-lg border border-white/10 bg-white/[0.03]
                     px-3 py-2 text-xs text-white/60
                     transition hover:border-[#D4AF37]/40 hover:text-white"
            >
              Bionexo
            </span>

            <span
              class="rounded-lg border border-white/10 bg-white/[0.03]
                     px-3 py-2 text-xs text-white/60
                     transition hover:border-[#D4AF37]/40 hover:text-white"
            >
              SAP Ariba
            </span>

            <span
              class="rounded-lg border border-white/10 bg-white/[0.03]
                     px-3 py-2 text-xs text-white/60
                     transition hover:border-[#D4AF37]/40 hover:text-white"
            >
              WherEx
            </span>

          </div>

        </div>

      </article>

    </div>

  </div>
</section>