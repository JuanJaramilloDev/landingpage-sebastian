---
---

<section
  id="proyectos"
  class="border-t border-white/5 bg-black px-6 py-28 lg:px-8"
>
  <div class="mx-auto max-w-7xl">

    <!-- ========================================== -->
    <!-- ENCABEZADO -->
    <!-- ========================================== -->

    <div
      class="mb-16 flex flex-col gap-6 md:flex-row md:items-end md:justify-between"
    >

      <div>

        <p
          class="mb-3 text-xs font-medium uppercase tracking-[0.3em] text-[#D4AF37]"
        >
          Áreas de experiencia
        </p>

        <h2
          class="text-4xl font-bold tracking-tight text-white sm:text-5xl"
        >
          Especialización
          <span class="text-[#D4AF37]"> profesional.</span>
        </h2>

      </div>


      <p class="max-w-md text-sm leading-6 text-white/50">
        Experiencia en licitaciones, contratación, elaboración de propuestas
        y gestión de procesos comerciales y contractuales.
      </p>

    </div>


    <!-- ========================================== -->
    <!-- ÁREAS -->
    <!-- ========================================== -->

    <div class="grid gap-6 md:grid-cols-2">


      <!-- ========================================== -->
      <!-- 01 - LICITACIONES -->
      <!-- ========================================== -->

      <article
        class="group overflow-hidden rounded-xl border border-white/10 bg-[#0D0D0D] transition-all duration-500 hover:-translate-y-1 hover:border-[#D4AF37]/40 hover:shadow-xl hover:shadow-black/30"
      >

        <div
          class="relative aspect-[16/10] overflow-hidden bg-[#111]"
        >

          <img
            src="/images/tarjeta1.png"
            alt="Gestión de licitaciones"
            class="h-full w-full object-cover grayscale transition duration-700 group-hover:scale-105 group-hover:grayscale-0"
          />

          <div
            class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent"
          ></div>

          <span
            class="absolute left-5 top-5 rounded-full border border-[#D4AF37]/40 bg-black/70 px-3 py-1 text-xs text-[#D4AF37] backdrop-blur-md"
          >
            Área 01
          </span>

        </div>


        <div class="p-6">

          <div class="flex items-start justify-between gap-4">

            <div>

              <h3 class="text-xl font-semibold text-white">
                Licitaciones
              </h3>

              <p class="mt-2 text-sm leading-6 text-white/50">
                Análisis y seguimiento de procesos de licitación, identificación
                de oportunidades y revisión de requisitos para la preparación
                de ofertas competitivas.
              </p>

            </div>


            <span
              class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-white/10 text-lg text-white/50 transition-all duration-300 group-hover:border-[#D4AF37] group-hover:text-[#D4AF37]"
            >
              01
            </span>

          </div>


          <div class="mt-6 flex flex-wrap gap-2">

            <span
              class="rounded border border-white/10 px-3 py-1.5 text-xs text-white/50"
            >
              SECOP I
            </span>

            <span
              class="rounded border border-white/10 px-3 py-1.5 text-xs text-white/50"
            >
              SECOP II
            </span>

            <span
              class="rounded border border-white/10 px-3 py-1.5 text-xs text-white/50"
            >
              TVEC
            </span>

          </div>

        </div>

      </article>


      <!-- ========================================== -->
      <!-- 02 - PROPUESTAS -->
      <!-- ========================================== -->

      <article
        class="group overflow-hidden rounded-xl border border-white/10 bg-[#0D0D0D] transition-all duration-500 hover:-translate-y-1 hover:border-[#D4AF37]/40 hover:shadow-xl hover:shadow-black/30"
      >

        <div
          class="relative aspect-[16/10] overflow-hidden bg-[#111]"
        >

          <img
            src="/images/tarjeta2.png"
            alt="Elaboración de propuestas técnicas y económicas"
            class="h-full w-full object-cover grayscale transition duration-700 group-hover:scale-105 group-hover:grayscale-0"
          />

          <div
            class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent"
          ></div>

          <span
            class="absolute left-5 top-5 rounded-full border border-[#D4AF37]/40 bg-black/70 px-3 py-1 text-xs text-[#D4AF37] backdrop-blur-md"
          >
            Área 02
          </span>

        </div>


        <div class="p-6">

          <div class="flex items-start justify-between gap-4">

            <div>

              <h3 class="text-xl font-semibold text-white">
                Propuestas Técnicas y Económicas
              </h3>

              <p class="mt-2 text-sm leading-6 text-white/50">
                Elaboración, estructuración y revisión de propuestas técnicas
                y económicas, presupuestos y documentación requerida para
                procesos de contratación.
              </p>

            </div>


            <span
              class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-white/10 text-lg text-white/50 transition-all duration-300 group-hover:border-[#D4AF37] group-hover:text-[#D4AF37]"
            >
              02
            </span>

          </div>


          <div class="mt-6 flex flex-wrap gap-2">

            <span
              class="rounded border border-white/10 px-3 py-1.5 text-xs text-white/50"
            >
              Propuestas
            </span>

            <span
              class="rounded border border-white/10 px-3 py-1.5 text-xs text-white/50"
            >
              Presupuestos
            </span>

            <span
              class="rounded border border-white/10 px-3 py-1.5 text-xs text-white/50"
            >
              Análisis de pliegos
            </span>

          </div>

        </div>

      </article>


      <!-- ========================================== -->
      <!-- 03 - CONTRATACIÓN -->
      <!-- ========================================== -->

      <article
        class="group overflow-hidden rounded-xl border border-white/10 bg-[#0D0D0D] transition-all duration-500 hover:-translate-y-1 hover:border-[#D4AF37]/40 hover:shadow-xl hover:shadow-black/30"
      >

        <div
          class="relative aspect-[16/10] overflow-hidden bg-[#111]"
        >

          <img
            src="/images/tarjeta3.png"
            alt="Contratación estatal y gestión contractual"
            class="h-full w-full object-cover grayscale transition duration-700 group-hover:scale-105 group-hover:grayscale-0"
          />

          <div
            class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent"
          ></div>

          <span
            class="absolute left-5 top-5 rounded-full border border-[#D4AF37]/40 bg-black/70 px-3 py-1 text-xs text-[#D4AF37] backdrop-blur-md"
          >
            Área 03
          </span>

        </div>


        <div class="p-6">

          <div class="flex items-start justify-between gap-4">

            <div>

              <h3 class="text-xl font-semibold text-white">
                Contratación y Gestión Contractual
              </h3>

              <p class="mt-2 text-sm leading-6 text-white/50">
                Gestión documental, seguimiento de procesos contractuales y
                apoyo en procedimientos relacionados con contratación pública
                y privada.
              </p>

            </div>


            <span
              class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-white/10 text-lg text-white/50 transition-all duration-300 group-hover:border-[#D4AF37] group-hover:text-[#D4AF37]"
            >
              03
            </span>

          </div>


          <div class="mt-6 flex flex-wrap gap-2">

            <span
              class="rounded border border-white/10 px-3 py-1.5 text-xs text-white/50"
            >
              Contratación Estatal
            </span>

            <span
              class="rounded border border-white/10 px-3 py-1.5 text-xs text-white/50"
            >
              Gestión Documental
            </span>

            <span
              class="rounded border border-white/10 px-3 py-1.5 text-xs text-white/50"
            >
              Seguimiento
            </span>

          </div>

        </div>

      </article>


      <!-- ========================================== -->
      <!-- 04 - RUP Y PLATAFORMAS -->
      <!-- ========================================== -->

      <article
        class="group overflow-hidden rounded-xl border border-white/10 bg-[#0D0D0D] transition-all duration-500 hover:-translate-y-1 hover:border-[#D4AF37]/40 hover:shadow-xl hover:shadow-black/30"
      >

        <div
          class="relative aspect-[16/10] overflow-hidden bg-[#111]"
        >

          <img
            src="/images/tarjeta4.png"
            alt="Plataformas de contratación y gestión del RUP"
            class="h-full w-full object-cover grayscale transition duration-700 group-hover:scale-105 group-hover:grayscale-0"
          />

          <div
            class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent"
          ></div>

          <span
            class="absolute left-5 top-5 rounded-full border border-[#D4AF37]/40 bg-black/70 px-3 py-1 text-xs text-[#D4AF37] backdrop-blur-md"
          > 
            Área 04
          </span>

        </div>


        <div class="p-6">

          <div class="flex items-start justify-between gap-4">

            <div>

              <h3 class="text-xl font-semibold text-white">
                RUP y Plataformas de Contratación
              </h3>

              <p class="mt-2 text-sm leading-6 text-white/50">
                Gestión y actualización de información empresarial, manejo de
                plataformas de contratación y apoyo documental para procesos
                de participación y oferta.
              </p>

            </div>


            <span
              class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-white/10 text-lg text-white/50 transition-all duration-300 group-hover:border-[#D4AF37] group-hover:text-[#D4AF37]"
            >
              04
            </span>

          </div>


          <div class="mt-6 flex flex-wrap gap-2">

            <span
              class="rounded border border-white/10 px-3 py-1.5 text-xs text-white/50"
            >
              RUP
            </span>

            <span
              class="rounded border border-white/10 px-3 py-1.5 text-xs text-white/50"
            >
              Bionexo
            </span>

            <span
              class="rounded border border-white/10 px-3 py-1.5 text-xs text-white/50"
            >
              Ariba
            </span>

            <span
              class="rounded border border-white/10 px-3 py-1.5 text-xs text-white/50"
            >
              SAP
            </span>

          </div>

        </div>

      </article>

    </div>


    <!-- ========================================== -->
    <!-- CTA -->
    <!-- ========================================== -->

    <div class="mt-14 flex justify-center">

      <button
        type="button"
        data-scroll="contacto"
        class="group inline-flex items-center gap-3 border-b border-[#D4AF37] pb-2 text-sm font-medium text-[#D4AF37] transition-all duration-300 hover:gap-5"
      >

        ¿Necesitas apoyo en un proceso de contratación?

        <span
          class="transition-transform duration-300 group-hover:translate-x-1"
        >
          →
        </span>

      </button>

    </div>

  </div>
</section>