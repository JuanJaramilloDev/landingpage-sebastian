---
---

<section
  id="experiencia"
  class="relative overflow-hidden border-t border-white/5 bg-[#080808] px-6 py-24 lg:px-8"
>

  <div
    class="animate-float-slow pointer-events-none absolute -right-40 top-10 h-96 w-96 rounded-full bg-[#D4AF37]/5 blur-3xl"
  ></div>

  <div class="relative mx-auto max-w-7xl">

    <!-- ========================================== -->
    <!-- ENCABEZADO -->
    <!-- ========================================== -->

    <div class="mb-16 max-w-3xl" data-reveal>

      <p
        class="mb-3 text-xs font-medium uppercase tracking-[0.3em] text-[#D4AF37]"
      >
        Sectores de experiencia
      </p>

      <h2
        class="text-4xl font-bold tracking-tight text-white sm:text-5xl"
      >
        Experiencia en
        <span class="text-[#D4AF37]"> diferentes sectores.</span>
      </h2>

      <p class="mt-5 max-w-2xl text-sm leading-7 text-white/50 sm:text-base">
        Trayectoria en la gestión de oportunidades, licitaciones,
        contratación y desarrollo de procesos para empresas de diferentes
        industrias y sectores.
      </p>

    </div>


    <!-- ========================================== -->
    <!-- SECTORES -->
    <!-- ========================================== -->

    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">


      <!-- ========================================== -->
      <!-- TELECOMUNICACIONES -->
      <!-- ========================================== -->

      <article
        class="group relative overflow-hidden rounded-2xl border border-white/10
               bg-[#0B0B0B] p-7 transition-all duration-500
               hover:-translate-y-1 hover:border-[#D4AF37]/40
               hover:shadow-xl hover:shadow-black/20"
        data-reveal
      >

        <!-- Número -->
        <div
          class="absolute right-6 top-6 text-xs font-medium tracking-[0.2em]
                 text-white/20 transition-colors duration-300
                 group-hover:text-[#D4AF37]/50"
        >
          01
        </div>


        <!-- Icono -->
        <div
          class="flex h-12 w-12 items-center justify-center rounded-xl
                 border border-[#D4AF37]/20 bg-[#D4AF37]/5
                 text-[#D4AF37] transition-all duration-300
                 group-hover:border-[#D4AF37]/50
                 group-hover:bg-[#D4AF37]/10"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="22"
            height="22"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M12 20v-8"></path>
            <path d="M8 20v-5"></path>
            <path d="M16 20v-5"></path>
            <path d="M4 20v-2"></path>
            <path d="M20 20v-2"></path>
            <path d="M12 4v4"></path>
            <path d="M8 6l4-2 4 2"></path>
            <path d="M5 11l3-2 4 2 4-2 3 2"></path>
          </svg>
        </div>


        <h3 class="mt-6 text-xl font-semibold text-white">
          Telecomunicaciones
        </h3>

        <p class="mt-3 text-sm leading-7 text-white/45">
          Participación en procesos relacionados con soluciones de
          telecomunicaciones, infraestructura y servicios tecnológicos.
        </p>

      </article>


      <!-- ========================================== -->
      <!-- TECNOLOGÍA -->
      <!-- ========================================== -->

      <article
        class="group relative overflow-hidden rounded-2xl border border-white/10
               bg-[#0B0B0B] p-7 transition-all duration-500
               hover:-translate-y-1 hover:border-[#D4AF37]/40
               hover:shadow-xl hover:shadow-black/20"
        data-reveal
        data-reveal-delay="1"
      >

        <div
          class="absolute right-6 top-6 text-xs font-medium tracking-[0.2em]
                 text-white/20 transition-colors duration-300
                 group-hover:text-[#D4AF37]/50"
        >
          02
        </div>


        <div
          class="flex h-12 w-12 items-center justify-center rounded-xl
                 border border-[#D4AF37]/20 bg-[#D4AF37]/5
                 text-[#D4AF37] transition-all duration-300
                 group-hover:border-[#D4AF37]/50
                 group-hover:bg-[#D4AF37]/10"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="22"
            height="22"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect x="3" y="4" width="18" height="12" rx="2"></rect>
            <path d="M8 20h8"></path>
            <path d="M12 16v4"></path>
            <path d="M7 8l2 2-2 2"></path>
            <path d="M11 12h4"></path>
          </svg>
        </div>


        <h3 class="mt-6 text-xl font-semibold text-white">
          Tecnología
        </h3>

        <p class="mt-3 text-sm leading-7 text-white/45">
          Experiencia en procesos de adquisición de hardware, infraestructura,
          soluciones tecnológicas y servicios especializados.
        </p>

      </article>


      <!-- ========================================== -->
      <!-- SALUD Y DISPOSITIVOS MÉDICOS -->
      <!-- ========================================== -->

      <article
        class="group relative overflow-hidden rounded-2xl border border-white/10
               bg-[#0B0B0B] p-7 transition-all duration-500
               hover:-translate-y-1 hover:border-[#D4AF37]/40
               hover:shadow-xl hover:shadow-black/20"
        data-reveal
        data-reveal-delay="2"
      >

        <div
          class="absolute right-6 top-6 text-xs font-medium tracking-[0.2em]
                 text-white/20 transition-colors duration-300
                 group-hover:text-[#D4AF37]/50"
        >
          03
        </div>


        <div
          class="flex h-12 w-12 items-center justify-center rounded-xl
                 border border-[#D4AF37]/20 bg-[#D4AF37]/5
                 text-[#D4AF37] transition-all duration-300
                 group-hover:border-[#D4AF37]/50
                 group-hover:bg-[#D4AF37]/10"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="22"
            height="22"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M19 14c1.5-1.5 2-3 2-5a5 5 0 0 0-9-3 5 5 0 0 0-9 3c0 5 5 8 9 11 1.5-1 3.2-2.1 4.5-3.2"></path>
            <path d="M12 8v6"></path>
            <path d="M9 11h6"></path>
          </svg>
        </div>


        <h3 class="mt-6 text-xl font-semibold text-white">
          Sector salud
        </h3>

        <p class="mt-3 text-sm leading-7 text-white/45">
          Experiencia en procesos relacionados con el sector salud,
          dispositivos médicos, equipos biomédicos y adquisiciones
          especializadas.
        </p>

      </article>


      <!-- ========================================== -->
      <!-- EVENTOS ARTÍSTICOS -->
      <!-- ========================================== -->

      <article
        class="group relative overflow-hidden rounded-2xl border border-white/10
               bg-[#0B0B0B] p-7 transition-all duration-500
               hover:-translate-y-1 hover:border-[#D4AF37]/40
               hover:shadow-xl hover:shadow-black/20"
        data-reveal
        data-reveal-delay="3"
      >

        <div
          class="absolute right-6 top-6 text-xs font-medium tracking-[0.2em]
                 text-white/20 transition-colors duration-300
                 group-hover:text-[#D4AF37]/50"
        >
          04
        </div>


        <div
          class="flex h-12 w-12 items-center justify-center rounded-xl
                 border border-[#D4AF37]/20 bg-[#D4AF37]/5
                 text-[#D4AF37] transition-all duration-300
                 group-hover:border-[#D4AF37]/50
                 group-hover:bg-[#D4AF37]/10"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="22"
            height="22"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M9 18V5l12-2v13"></path>
            <circle cx="6" cy="18" r="3"></circle>
            <circle cx="18" cy="16" r="3"></circle>
          </svg>
        </div>


        <h3 class="mt-6 text-xl font-semibold text-white">
          Eventos artísticos
        </h3>

        <p class="mt-3 text-sm leading-7 text-white/45">
          Gestión y coordinación de procesos relacionados con contratación,
          organización y ejecución de eventos y actividades artísticas.
        </p>

      </article>


      <!-- ========================================== -->
      <!-- ENERGÍAS RENOVABLES -->
      <!-- ========================================== -->

      <article
        class="group relative overflow-hidden rounded-2xl border border-white/10
               bg-[#0B0B0B] p-7 transition-all duration-500
               hover:-translate-y-1 hover:border-[#D4AF37]/40
               hover:shadow-xl hover:shadow-black/20"
        data-reveal
      >

        <div
          class="absolute right-6 top-6 text-xs font-medium tracking-[0.2em]
                 text-white/20 transition-colors duration-300
                 group-hover:text-[#D4AF37]/50"
        >
          05
        </div>


        <div
          class="flex h-12 w-12 items-center justify-center rounded-xl
                 border border-[#D4AF37]/20 bg-[#D4AF37]/5
                 text-[#D4AF37] transition-all duration-300
                 group-hover:border-[#D4AF37]/50
                 group-hover:bg-[#D4AF37]/10"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="22"
            height="22"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M12 3v2"></path>
            <path d="M12 19v2"></path>
            <path d="M4.22 4.22l1.42 1.42"></path>
            <path d="M18.36 18.36l1.42 1.42"></path>
            <path d="M3 12h2"></path>
            <path d="M19 12h2"></path>
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M15 16l-2 5h4l2-5"></path>
          </svg>
        </div>


        <h3 class="mt-6 text-xl font-semibold text-white">
          Energías renovables
        </h3>

        <p class="mt-3 max-w-2xl text-sm leading-7 text-white/45">
          Experiencia en oportunidades y procesos relacionados con soluciones
          de energía solar, infraestructura energética y proyectos de
          energías renovables.
        </p>

      </article>

      <!-- ========================================== -->
      <!-- SUMINISTROS Y SOLUCIONES INTEGRALES -->
      <!-- ========================================== -->

      <article
        class="group relative overflow-hidden rounded-2xl border border-white/10
              bg-[#0B0B0B] p-7 transition-all duration-500
              hover:-translate-y-1 hover:border-[#D4AF37]/40
              hover:shadow-xl hover:shadow-black/20"
        data-reveal
        data-reveal-delay="1"
      >

        <div
          class="absolute right-6 top-6 text-xs font-medium tracking-[0.2em]
                text-white/20 transition-colors duration-300
                group-hover:text-[#D4AF37]/50"
        >
          06
        </div>


        <!-- Icono -->
        <div
          class="flex h-12 w-12 items-center justify-center rounded-xl
                border border-[#D4AF37]/20 bg-[#D4AF37]/5
                text-[#D4AF37] transition-all duration-300
                group-hover:border-[#D4AF37]/50
                group-hover:bg-[#D4AF37]/10"
        >

          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="22"
            height="22"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"></path>
            <path d="m3.3 7 8.7 5 8.7-5"></path>
            <path d="M12 22V12"></path>
          </svg>

        </div>


        <h3 class="mt-6 text-xl font-semibold text-white">
          Suministros y soluciones integrales
        </h3>


        <p class="mt-3 text-sm leading-7 text-white/45">
          Experiencia en procesos de suministro de bienes y soluciones para
          diferentes necesidades empresariales y del sector público, adaptándose
          a los requerimientos específicos de cada proceso.
        </p>

      </article>

    </div>

    <!-- ========================================== -->
    <!-- LINKEDIN / MÁS EXPERIENCIA -->
    <!-- ========================================== -->

    <div
      class="mt-20 overflow-hidden rounded-2xl border border-white/10
             bg-[#0B0B0B]"
      data-reveal
    >

      <div
        class="flex flex-col gap-8 p-8 sm:p-10 lg:flex-row lg:items-center
               lg:justify-between"
      >

        <div class="max-w-2xl">

          <p
            class="text-xs font-medium uppercase tracking-[0.3em] text-[#D4AF37]"
          >
            Para más experiencia
          </p>

          <h3
            class="mt-3 text-2xl font-semibold tracking-tight text-white sm:text-3xl"
          >
            Conoce más sobre la trayectoria profesional.
          </h3>

          <p class="mt-4 text-sm leading-7 text-white/45">
            Explora el perfil profesional de nuestro ceo para conocer más sobre 
            la experiencia, proyectos, formación y trayectoria en diferentes
            sectores.
          </p>

        </div>


        <!-- LinkedIn -->
        <a
          href="https://www.linkedin.com/in/juan-sebastian-guerra-diaz-b365872b3/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn"
          class="inline-flex h-15 shrink-0 items-center justify-center gap-3
                 rounded border border-[#0A66C2]/40 bg-[#0A66C2]/5 px-10
                 text-sm font-medium text-[#0A66C2]
                 transition-all duration-300
                 hover:-translate-y-1 hover:border-[#0A66C2]
                 hover:bg-[#0A66C2]/10"
        >

          <span class="text-lg font-bold">
            in
          </span>

          <span>
            LinkedIn
          </span>

          <span class="ml-1 text-base">
            →
          </span>

        </a>

      </div>


      <!-- Línea inferior decorativa -->
      <div class="h-px bg-gradient-to-r from-transparent via-[#D4AF37]/30 to-transparent"></div>

    </div>

  </div>
</section>