---
---

<section
  id="experiencia"
  class="border-t border-white/5 bg-[#080808] px-6 py-24 lg:px-8"
>
  <div class="mx-auto max-w-7xl">

    <!-- ========================================== -->
    <!-- ENCABEZADO -->
    <!-- ========================================== -->

    <div class="mb-16 max-w-3xl">

      <p
        class="mb-3 text-xs font-medium uppercase tracking-[0.3em] text-[#D4AF37]"
      >
        Experiencia aplicada
      </p>

      <h2
        class="text-4xl font-bold tracking-tight text-white sm:text-5xl"
      >
        Experiencia que
        <span class="text-[#D4AF37]"> respalda el trabajo.</span>
      </h2>

      <p class="mt-5 max-w-2xl text-sm leading-7 text-white/50 sm:text-base">
        Experiencia en procesos de contratación, licitaciones y gestión de
        oportunidades para empresas y entidades de diferentes sectores.
      </p>

    </div>


    <!-- ========================================== -->
    <!-- EMPRESAS -->
    <!-- ========================================== -->

    <div class="grid gap-6 md:grid-cols-2">


      <!-- ========================================== -->
      <!-- ENFISA -->
      <!-- ========================================== -->

      <article
        class="group relative overflow-hidden rounded-2xl border border-white/10
               bg-[#0B0B0B] p-7 transition-all duration-500
               hover:-translate-y-1 hover:border-[#D4AF37]/40
               hover:shadow-xl hover:shadow-black/20 sm:p-8"
      >

        <div class="flex items-start justify-between gap-6">

          <div>

            <p
              class="text-xs font-medium uppercase tracking-[0.2em] text-[#D4AF37]"
            >
              Sector salud
            </p>

            <h3 class="mt-3 text-2xl font-semibold text-white">
              ENFISA S.A.S.
            </h3>

          </div>

          <div
            class="flex h-12 w-12 shrink-0 items-center justify-center
                   rounded-xl border border-white/10 bg-white/[0.03]
                   text-sm font-semibold text-[#D4AF37]"
          >
            01
          </div>

        </div>


        <div class="my-6 h-px bg-white/10"></div>


        <p class="text-xs font-medium uppercase tracking-[0.2em] text-white/30">
          Trabajo realizado
        </p>

        <p class="mt-3 text-sm leading-7 text-white/50">
          Liderazgo y gestión de procesos de licitación para la venta de
          dispositivos médicos al sector público y privado, desde el análisis
          de oportunidades hasta la preparación de propuestas.
        </p>


        <div class="mt-6 flex flex-wrap gap-2">

          <span class="rounded-lg border border-white/10 bg-white/[0.03] px-3 py-2 text-xs text-white/50">
            Licitaciones
          </span>

          <span class="rounded-lg border border-white/10 bg-white/[0.03] px-3 py-2 text-xs text-white/50">
            Propuestas
          </span>

          <span class="rounded-lg border border-white/10 bg-white/[0.03] px-3 py-2 text-xs text-white/50">
            Sector público
          </span>

          <span class="rounded-lg border border-white/10 bg-white/[0.03] px-3 py-2 text-xs text-white/50">
            Sector privado
          </span>

        </div>

      </article>


      <!-- ========================================== -->
      <!-- IMS -->
      <!-- ========================================== -->

      <article
        class="group relative overflow-hidden rounded-2xl border border-white/10
               bg-[#0B0B0B] p-7 transition-all duration-500
               hover:-translate-y-1 hover:border-[#D4AF37]/40
               hover:shadow-xl hover:shadow-black/20 sm:p-8"
      >

        <div class="flex items-start justify-between gap-6">

          <div>

            <p
              class="text-xs font-medium uppercase tracking-[0.2em] text-[#D4AF37]"
            >
              Tecnología y gobierno
            </p>

            <h3 class="mt-3 text-2xl font-semibold text-white">
              IMS Mayorista S.A.S.
            </h3>

          </div>

          <div
            class="flex h-12 w-12 shrink-0 items-center justify-center
                   rounded-xl border border-white/10 bg-white/[0.03]
                   text-sm font-semibold text-[#D4AF37]"
          >
            02
          </div>

        </div>


        <div class="my-6 h-px bg-white/10"></div>


        <p class="text-xs font-medium uppercase tracking-[0.2em] text-white/30">
          Trabajo realizado
        </p>

        <p class="mt-3 text-sm leading-7 text-white/50">
          Gestión de procesos de licitación para soluciones tecnológicas,
          incluyendo hardware, infraestructura de red y energía solar,
          coordinando propuestas con equipos internos y proveedores.
        </p>


        <div class="mt-6 flex flex-wrap gap-2">

          <span class="rounded-lg border border-white/10 bg-white/[0.03] px-3 py-2 text-xs text-white/50">
            Tecnología
          </span>

          <span class="rounded-lg border border-white/10 bg-white/[0.03] px-3 py-2 text-xs text-white/50">
            Licitaciones
          </span>

          <span class="rounded-lg border border-white/10 bg-white/[0.03] px-3 py-2 text-xs text-white/50">
            Propuestas
          </span>

          <span class="rounded-lg border border-white/10 bg-white/[0.03] px-3 py-2 text-xs text-white/50">
            Proveedores
          </span>

        </div>

      </article>


      <!-- ========================================== -->
      <!-- GOBERNACIÓN -->
      <!-- ========================================== -->

      <article
        class="group relative overflow-hidden rounded-2xl border border-white/10
               bg-[#0B0B0B] p-7 transition-all duration-500
               hover:-translate-y-1 hover:border-[#D4AF37]/40
               hover:shadow-xl hover:shadow-black/20 sm:p-8"
      >

        <div class="flex items-start justify-between gap-6">

          <div>

            <p
              class="text-xs font-medium uppercase tracking-[0.2em] text-[#D4AF37]"
            >
              Sector público · Salud
            </p>

            <h3 class="mt-3 text-2xl font-semibold text-white">
              Gobernación de Nariño
            </h3>

          </div>

          <div
            class="flex h-12 w-12 shrink-0 items-center justify-center
                   rounded-xl border border-white/10 bg-white/[0.03]
                   text-sm font-semibold text-[#D4AF37]"
          >
            03
          </div>

        </div>


        <div class="my-6 h-px bg-white/10"></div>


        <p class="text-xs font-medium uppercase tracking-[0.2em] text-white/30">
          Trabajo realizado
        </p>

        <p class="mt-3 text-sm leading-7 text-white/50">
          Participación en procesos relacionados con la adquisición de
          equipos biomédicos, vehículos asistenciales y utilitarios,
          realizando análisis técnico, evaluación de propuestas y
          validación de especificaciones.
        </p>


        <div class="mt-6 flex flex-wrap gap-2">

          <span class="rounded-lg border border-white/10 bg-white/[0.03] px-3 py-2 text-xs text-white/50">
            Adquisiciones
          </span>

          <span class="rounded-lg border border-white/10 bg-white/[0.03] px-3 py-2 text-xs text-white/50">
            Evaluación técnica
          </span>

          <span class="rounded-lg border border-white/10 bg-white/[0.03] px-3 py-2 text-xs text-white/50">
            Licitaciones
          </span>

          <span class="rounded-lg border border-white/10 bg-white/[0.03] px-3 py-2 text-xs text-white/50">
            Sector público
          </span>

        </div>

      </article>


      <!-- ========================================== -->
      <!-- SINAPSIS -->
      <!-- ========================================== -->

      <article
        class="group relative overflow-hidden rounded-2xl border border-white/10
               bg-[#0B0B0B] p-7 transition-all duration-500
               hover:-translate-y-1 hover:border-[#D4AF37]/40
               hover:shadow-xl hover:shadow-black/20 sm:p-8"
      >

        <div class="flex items-start justify-between gap-6">

          <div>

            <p
              class="text-xs font-medium uppercase tracking-[0.2em] text-[#D4AF37]"
            >
              Contratación y licitaciones
            </p>

            <h3 class="mt-3 text-2xl font-semibold text-white">
              SINAPSIS S.A.S.
            </h3>

          </div>

          <div
            class="flex h-12 w-12 shrink-0 items-center justify-center
                   rounded-xl border border-white/10 bg-white/[0.03]
                   text-sm font-semibold text-[#D4AF37]"
          >
            04
          </div>

        </div>


        <div class="my-6 h-px bg-white/10"></div>


        <p class="text-xs font-medium uppercase tracking-[0.2em] text-white/30">
          Trabajo realizado
        </p>

        <p class="mt-3 text-sm leading-7 text-white/50">
          Participación y apoyo en procesos de licitación, revisión de
          documentación, seguimiento de oportunidades y gestión de
          requerimientos para procesos de contratación.
        </p>


        <div class="mt-6 flex flex-wrap gap-2">

          <span class="rounded-lg border border-white/10 bg-white/[0.03] px-3 py-2 text-xs text-white/50">
            Licitaciones
          </span>

          <span class="rounded-lg border border-white/10 bg-white/[0.03] px-3 py-2 text-xs text-white/50">
            Contratación
          </span>

          <span class="rounded-lg border border-white/10 bg-white/[0.03] px-3 py-2 text-xs text-white/50">
            Gestión documental
          </span>

          <span class="rounded-lg border border-white/10 bg-white/[0.03] px-3 py-2 text-xs text-white/50">
            Seguimiento
          </span>

        </div>

      </article>


      <!-- ========================================== -->
      <!-- EVENTOS TORNILLITO -->
      <!-- ========================================== -->

      <article
        class="group relative overflow-hidden rounded-2xl border border-white/10
               bg-[#0B0B0B] p-7 transition-all duration-500
               hover:-translate-y-1 hover:border-[#D4AF37]/40
               hover:shadow-xl hover:shadow-black/20 sm:p-8
               md:col-span-2"
      >

        <div class="grid gap-8 md:grid-cols-[1fr_2fr] md:items-center">

          <div>

            <p
              class="text-xs font-medium uppercase tracking-[0.2em] text-[#D4AF37]"
            >
              Gestión y contratación
            </p>

            <h3 class="mt-3 text-2xl font-semibold text-white">
              Eventos Tornillito
            </h3>

            <div
              class="mt-5 flex h-12 w-12 items-center justify-center
                     rounded-xl border border-white/10 bg-white/[0.03]
                     text-sm font-semibold text-[#D4AF37]"
            >
              05
            </div>

          </div>


          <div>

            <p
              class="text-xs font-medium uppercase tracking-[0.2em] text-white/30"
            >
              Trabajo realizado
            </p>

            <p class="mt-3 text-sm leading-7 text-white/50">
              Gestión y apoyo en procesos relacionados con contratación,
              organización y desarrollo de actividades para eventos,
              coordinando requerimientos y diferentes aspectos necesarios
              para la ejecución de los servicios.
            </p>


            <div class="mt-6 flex flex-wrap gap-2">

              <span
                class="rounded-lg border border-white/10 bg-white/[0.03]
                       px-3 py-2 text-xs text-white/50"
              >
                Gestión
              </span>

              <span
                class="rounded-lg border border-white/10 bg-white/[0.03]
                       px-3 py-2 text-xs text-white/50"
              >
                Contratación
              </span>

              <span
                class="rounded-lg border border-white/10 bg-white/[0.03]
                       px-3 py-2 text-xs text-white/50"
              >
                Coordinación
              </span>

              <span
                class="rounded-lg border border-white/10 bg-white/[0.03]
                       px-3 py-2 text-xs text-white/50"
              >
                Eventos
              </span>

            </div>

          </div>

        </div>

      </article>


    </div>


    <!-- ========================================== -->
    <!-- CIERRE -->
    <!-- ========================================== -->

    <div
      class="mt-14 flex flex-col gap-5 border-t border-white/10 pt-10
             sm:flex-row sm:items-center sm:justify-between"
    >

      <div>

        <p class="text-lg font-semibold text-white">
          Experiencia aplicada a nuevos desafíos.
        </p>

        <p class="mt-2 text-sm text-white/40">
          Cada proceso requiere una estrategia diferente.
        </p>

      </div>


      <a
        href="/#contacto"
        class="group inline-flex items-center gap-3 text-sm
               font-medium text-[#D4AF37] transition-all duration-300
               hover:gap-5"
      >
        Hablemos de tu proceso

        <span
          class="transition-transform duration-300 group-hover:translate-x-1"
        >
          →
        </span>

      </a>

    </div>

  </div>
</section>